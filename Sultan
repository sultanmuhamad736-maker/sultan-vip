#!/usr/bin/env bash
# ==========================================================
# SULTAN VIP - V2RAY + DNS
# V2Ray TCP/TLS + DNS فقط
# بدون WebSocket / بدون XHTTP
# رقم 10 = Setting
# لا يوجد Auto Setup عند تشغيل السكربت
# ==========================================================

set +e

APP_NAME="SULTAN VIP"
APP_VER="V2RAY + DNS"
BASE="/etc/sultan"
DOMAIN_FILE="$BASE/domain"
XDB="$BASE/xray"
DNS_DIR="$BASE/dns"
RECORDS_DB="$DNS_DIR/records.db"
XRAY_CONFIG="/usr/local/etc/xray/config.json"
DNSMASQ_CONF="/etc/dnsmasq.d/sultan-v2ray-dns.conf"

VLESS_PORT="443"
VMESS_PORT="8443"
TROJAN_PORT="2083"

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
PURPLE='\033[1;35m'
NC='\033[0m'

mkdir -p "$BASE" "$XDB" "$DNS_DIR"
touch "$RECORDS_DB"

pause(){ echo ""; read -rp "Press Enter..." _; }
clearx(){ clear 2>/dev/null || true; }

get_ip(){
  curl -4 -s --max-time 3 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}'
}

get_domain(){
  if [ -s "$DOMAIN_FILE" ]; then
    cat "$DOMAIN_FILE"
  else
    echo "Not Set"
  fi
}

svc(){
  systemctl is-active "$1" 2>/dev/null || echo "inactive"
}

box(){
  printf "${BLUE}%-18s${NC}: ${WHITE}%s${NC}\n" "$1" "$2"
}

header(){
  clearx
  DOMAIN="$(get_domain)"
  IP="$(get_ip)"
  echo -e "${PURPLE}╔════════════════════════════════════════════════════╗${NC}"
  echo -e "${PURPLE}║${WHITE}                    SULTAN VIP                     ${PURPLE}║${NC}"
  echo -e "${PURPLE}║${WHITE}                    V2RAY + DNS                   ${PURPLE}║${NC}"
  echo -e "${PURPLE}║${WHITE}               TCP/TLS | DNS | XRAY               ${PURPLE}║${NC}"
  echo -e "${PURPLE}╚════════════════════════════════════════════════════╝${NC}"
  box "Domain" "$DOMAIN"
  box "Server IP" "$IP"
  box "Xray" "$(svc xray)"
  box "DNS" "$(svc dnsmasq)"
  box "Nginx 80" "$(svc nginx)"
  box "Port 443" "$(ss -tulpn 2>/dev/null | grep -q ':443 ' && echo OPEN || echo CLOSED)"
  box "Port 53" "$(ss -tulpn 2>/dev/null | grep -q ':53 ' && echo OPEN || echo CLOSED)"
  echo -e "${PURPLE}────────────────────────────────────────────────────${NC}"
}

install_menu_command(){
  cp "$0" /usr/local/bin/menu 2>/dev/null || true
  chmod +x /usr/local/bin/menu 2>/dev/null || true
}

install_base(){
  header
  echo -e "${YELLOW}Installing base packages...${NC}"
  apt update -y
  apt install -y curl wget socat cron jq uuid-runtime openssl ca-certificates \
    nginx openssh-server dnsmasq dnsutils ufw psmisc iproute2 net-tools lsof \
    qrencode unzip certbot
  systemctl enable nginx dnsmasq ssh 2>/dev/null || true
  echo -e "${GREEN}Base packages installed.${NC}"
  pause
}

install_xray(){
  header
  echo -e "${YELLOW}Installing / repairing Xray core...${NC}"
  bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
  mkdir -p /usr/local/etc/xray "$XDB"
  systemctl enable xray 2>/dev/null || true
  echo -e "${GREEN}Xray installed.${NC}"
  pause
}

set_domain(){
  header
  read -rp "Enter domain: " D
  [ -z "$D" ] && echo -e "${RED}Empty domain.${NC}" && pause && return
  echo "$D" > "$DOMAIN_FILE"
  echo -e "${GREEN}Domain saved: $D${NC}"
  pause
}

issue_ssl(){
  header
  D="$(get_domain)"
  [ "$D" = "Not Set" ] && echo "Set domain first." && pause && return

  systemctl stop nginx xray haproxy 2>/dev/null || true
  fuser -k 80/tcp 2>/dev/null || true

  certbot certonly --standalone \
    -d "$D" \
    --cert-name "$D" \
    --agree-tos \
    -m "admin@$D" \
    --non-interactive \
    --preferred-challenges http

  systemctl restart nginx 2>/dev/null || true
  systemctl restart xray 2>/dev/null || true
  pause
}

cert_file(){
  D="$(get_domain)"
  if [ -f "/etc/letsencrypt/live/$D/fullchain.pem" ]; then
    echo "/etc/letsencrypt/live/$D/fullchain.pem"
  else
    echo "/etc/sultan/fallback-$D.crt"
  fi
}

key_file(){
  D="$(get_domain)"
  if [ -f "/etc/letsencrypt/live/$D/privkey.pem" ]; then
    echo "/etc/letsencrypt/live/$D/privkey.pem"
  else
    echo "/etc/sultan/fallback-$D.key"
  fi
}

ensure_cert(){
  D="$(get_domain)"
  [ "$D" = "Not Set" ] && D="$(get_ip)"
  CERT="$(cert_file)"
  KEY="$(key_file)"

  if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then
    mkdir -p /etc/sultan
    openssl req -x509 -nodes -newkey rsa:2048 \
      -keyout "$KEY" \
      -out "$CERT" \
      -days 3650 \
      -subj "/CN=$D" >/dev/null 2>&1
  fi
}

configure_nginx_80(){
  header
  D="$(get_domain)"
  [ "$D" = "Not Set" ] && D="_"

  systemctl stop nginx 2>/dev/null || true
  rm -f /etc/nginx/conf.d/*.conf /etc/nginx/sites-enabled/*

  cat >/etc/nginx/conf.d/sultan-nginx-80.conf <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name $D;

    location / {
        return 200 "SULTAN V2RAY DNS OK";
        add_header Content-Type text/plain;
    }

    location /ok {
        return 200 "SULTAN 200 OK";
        add_header Content-Type text/plain;
    }

    location /block {
        return 403 "SULTAN 403";
        add_header Content-Type text/plain;
    }
}
EOF

  nginx -t && systemctl enable nginx >/dev/null 2>&1 && systemctl restart nginx
  echo -e "${GREEN}Nginx configured on port 80 only.${NC}"
  pause
}

configure_dns(){
  header
  D="$(get_domain)"
  IP="$(get_ip)"
  [ "$D" = "Not Set" ] && D="local.sultan"

  cat >"$DNSMASQ_CONF" <<EOF
# SULTAN VIP V2RAY + DNS
port=53
domain-needed
bogus-priv
no-resolv
server=1.1.1.1
server=8.8.8.8
server=9.9.9.9
cache-size=10000
log-queries
log-facility=/var/log/sultan-dns.log

# Main domain
address=/$D/$IP
EOF

  while IFS='|' read -r TYPE NAME VALUE; do
    [ -z "$TYPE" ] && continue
    [ -z "$NAME" ] && continue
    [ -z "$VALUE" ] && continue

    if [ "$NAME" = "@" ]; then
      FQDN="$D"
    elif [ "$NAME" = "*" ]; then
      FQDN="$D"
    elif echo "$NAME" | grep -q '\.'; then
      FQDN="$NAME"
    else
      FQDN="$NAME.$D"
    fi

    case "$TYPE" in
      A)
        if [ "$NAME" = "*" ]; then
          echo "address=/$D/$VALUE" >> "$DNSMASQ_CONF"
        else
          echo "address=/$FQDN/$VALUE" >> "$DNSMASQ_CONF"
        fi
      ;;
      CNAME)
        echo "cname=$FQDN,$VALUE" >> "$DNSMASQ_CONF"
      ;;
    esac
  done < "$RECORDS_DB"

  systemctl stop systemd-resolved 2>/dev/null || true
  systemctl disable systemd-resolved 2>/dev/null || true

  rm -f /etc/resolv.conf
  cat >/etc/resolv.conf <<EOF
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF

  fuser -k 53/tcp 2>/dev/null || true
  fuser -k 53/udp 2>/dev/null || true

  dnsmasq --test --conf-file="$DNSMASQ_CONF"
  systemctl enable dnsmasq 2>/dev/null || true
  systemctl restart dnsmasq

  ufw allow 53/tcp 2>/dev/null || true
  ufw allow 53/udp 2>/dev/null || true

  echo -e "${GREEN}DNS configured on port 53.${NC}"
  pause
}

add_dns_record(){
  header
  echo "[1] A Record"
  echo "[2] CNAME Record"
  echo "[3] Wildcard A Record"
  read -rp "Select: " T
  case "$T" in
    1)
      TYPE="A"
      read -rp "Name, example @ or app: " NAME
      read -rp "IPv4: " VALUE
    ;;
    2)
      TYPE="CNAME"
      read -rp "Name, example www: " NAME
      read -rp "Target domain: " VALUE
    ;;
    3)
      TYPE="A"
      NAME="*"
      read -rp "Wildcard IPv4: " VALUE
    ;;
    *)
      return
    ;;
  esac
  [ -z "$NAME" ] && pause && return
  [ -z "$VALUE" ] && pause && return
  echo "$TYPE|$NAME|$VALUE" >> "$RECORDS_DB"
  echo -e "${GREEN}DNS record added.${NC}"
  pause
}

list_dns_records(){
  header
  echo -e "${CYAN}DNS Records:${NC}"
  if [ ! -s "$RECORDS_DB" ]; then
    echo "No records."
  else
    nl -ba "$RECORDS_DB"
  fi
  pause
}

delete_dns_record(){
  header
  [ ! -s "$RECORDS_DB" ] && echo "No records." && pause && return
  nl -ba "$RECORDS_DB"
  read -rp "Line number: " N
  [ -z "$N" ] && return
  sed -i "${N}d" "$RECORDS_DB"
  echo -e "${GREEN}Deleted.${NC}"
  pause
}

read_clients_json(){
  python3 - <<PY
import json, os
xdb="$XDB"

def read_db(proto):
    p=os.path.join(xdb, proto+".db")
    arr=[]
    if not os.path.exists(p):
        return arr
    for line in open(p, errors="ignore"):
        x=line.strip().split("|")
        if len(x)<2: continue
        u=x[0].strip()
        v=x[1].strip()
        if proto=="vless":
            arr.append({"id":v,"email":u})
        elif proto=="vmess":
            arr.append({"id":v,"alterId":0,"email":u})
        elif proto=="trojan":
            arr.append({"password":v,"email":u})
    return arr

print(json.dumps({
  "vless": read_db("vless"),
  "vmess": read_db("vmess"),
  "trojan": read_db("trojan")
}))
PY
}

configure_xray_v2ray_dns(){
  header
  D="$(get_domain)"
  [ "$D" = "Not Set" ] && echo "Set domain first." && pause && return

  command -v xray >/dev/null 2>&1 || [ -x /usr/local/bin/xray ] || {
    echo "Xray not installed. Run Setting > Install Xray first."
    pause
    return
  }

  ensure_cert
  CERT="$(cert_file)"
  KEY="$(key_file)"

  mkdir -p /usr/local/etc/xray "$XDB"

  CLIENTS="$(read_clients_json)"
  VLESS_CLIENTS="$(echo "$CLIENTS" | jq -c '.vless')"
  VMESS_CLIENTS="$(echo "$CLIENTS" | jq -c '.vmess')"
  TROJAN_CLIENTS="$(echo "$CLIENTS" | jq -c '.trojan')"

  cat >"$XRAY_CONFIG" <<EOF
{
  "log": {"loglevel": "warning"},
  "dns": {
    "servers": [
      "https+local://1.1.1.1/dns-query",
      "https+local://8.8.8.8/dns-query",
      "1.1.1.1",
      "8.8.8.8",
      "localhost"
    ],
    "queryStrategy": "UseIP"
  },
  "inbounds": [
    {
      "tag": "vless-tcp-tls",
      "listen": "0.0.0.0",
      "port": $VLESS_PORT,
      "protocol": "vless",
      "settings": {"clients": $VLESS_CLIENTS, "decryption": "none"},
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "$D",
          "certificates": [{"certificateFile": "$CERT", "keyFile": "$KEY"}],
          "alpn": ["http/1.1"]
        }
      }
    },
    {
      "tag": "vmess-tcp-tls",
      "listen": "0.0.0.0",
      "port": $VMESS_PORT,
      "protocol": "vmess",
      "settings": {"clients": $VMESS_CLIENTS},
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "$D",
          "certificates": [{"certificateFile": "$CERT", "keyFile": "$KEY"}],
          "alpn": ["http/1.1"]
        }
      }
    },
    {
      "tag": "trojan-tcp-tls",
      "listen": "0.0.0.0",
      "port": $TROJAN_PORT,
      "protocol": "trojan",
      "settings": {"clients": $TROJAN_CLIENTS},
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "$D",
          "certificates": [{"certificateFile": "$CERT", "keyFile": "$KEY"}],
          "alpn": ["http/1.1"]
        }
      }
    }
  ],
  "outbounds": [
    {"tag":"direct","protocol":"freedom","settings":{"domainStrategy":"UseIP"}},
    {"tag":"block","protocol":"blackhole"}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {"type":"field","outboundTag":"block","protocol":["bittorrent"]},
      {"type":"field","outboundTag":"direct","network":"tcp,udp"}
    ]
  }
}
EOF

  systemctl stop haproxy 2>/dev/null || true
  systemctl disable haproxy 2>/dev/null || true

  xray run -test -config "$XRAY_CONFIG" && systemctl enable xray >/dev/null 2>&1 && systemctl restart xray
  echo -e "${GREEN}Xray V2Ray + DNS configured. No WebSocket.${NC}"
  pause
}

create_user(){
  header
  PROTO="$1"
  D="$(get_domain)"
  [ "$D" = "Not Set" ] && echo "Set domain first." && pause && return

  mkdir -p "$XDB"
  read -rp "Username: " USER
  [ -z "$USER" ] && echo "Empty username." && pause && return

  if [ "$PROTO" = "trojan" ]; then
    PASS="$(openssl rand -hex 8)"
    echo "$USER|$PASS|trojan|tcp-tls|$D|$TROJAN_PORT" >> "$XDB/trojan.db"
  else
    UUID="$(uuidgen)"
    echo "$USER|$UUID|$PROTO|tcp-tls|$D|$( [ "$PROTO" = "vless" ] && echo "$VLESS_PORT" || echo "$VMESS_PORT" )" >> "$XDB/$PROTO.db"
  fi

  configure_xray_v2ray_dns_quiet

  header
  echo -e "${GREEN}$PROTO user created.${NC}"
  if [ "$PROTO" = "vless" ]; then
    echo "vless://$UUID@$D:$VLESS_PORT?type=tcp&encryption=none&security=tls&sni=$D&fp=chrome#$USER"
  elif [ "$PROTO" = "vmess" ]; then
    JSON="{\"v\":\"2\",\"ps\":\"$USER\",\"add\":\"$D\",\"port\":\"$VMESS_PORT\",\"id\":\"$UUID\",\"aid\":\"0\",\"scy\":\"auto\",\"net\":\"tcp\",\"type\":\"none\",\"host\":\"\",\"path\":\"\",\"tls\":\"tls\",\"sni\":\"$D\"}"
    echo "vmess://$(echo -n "$JSON" | base64 -w 0 2>/dev/null || echo -n "$JSON" | base64 | tr -d '\n')"
  else
    echo "trojan://$PASS@$D:$TROJAN_PORT?security=tls&sni=$D&fp=chrome#$USER"
  fi
  pause
}

configure_xray_v2ray_dns_quiet(){
  D="$(get_domain)"
  [ "$D" = "Not Set" ] && return
  command -v xray >/dev/null 2>&1 || [ -x /usr/local/bin/xray ] || return
  ensure_cert
  CERT="$(cert_file)"
  KEY="$(key_file)"
  CLIENTS="$(read_clients_json)"
  VLESS_CLIENTS="$(echo "$CLIENTS" | jq -c '.vless')"
  VMESS_CLIENTS="$(echo "$CLIENTS" | jq -c '.vmess')"
  TROJAN_CLIENTS="$(echo "$CLIENTS" | jq -c '.trojan')"

  mkdir -p /usr/local/etc/xray

  cat >"$XRAY_CONFIG" <<EOF
{
  "log": {"loglevel": "warning"},
  "dns": {"servers": ["https+local://1.1.1.1/dns-query","https+local://8.8.8.8/dns-query","localhost"], "queryStrategy": "UseIP"},
  "inbounds": [
    {"tag":"vless-tcp-tls","listen":"0.0.0.0","port":$VLESS_PORT,"protocol":"vless","settings":{"clients":$VLESS_CLIENTS,"decryption":"none"},"streamSettings":{"network":"tcp","security":"tls","tlsSettings":{"serverName":"$D","certificates":[{"certificateFile":"$CERT","keyFile":"$KEY"}],"alpn":["http/1.1"]}}},
    {"tag":"vmess-tcp-tls","listen":"0.0.0.0","port":$VMESS_PORT,"protocol":"vmess","settings":{"clients":$VMESS_CLIENTS},"streamSettings":{"network":"tcp","security":"tls","tlsSettings":{"serverName":"$D","certificates":[{"certificateFile":"$CERT","keyFile":"$KEY"}],"alpn":["http/1.1"]}}},
    {"tag":"trojan-tcp-tls","listen":"0.0.0.0","port":$TROJAN_PORT,"protocol":"trojan","settings":{"clients":$TROJAN_CLIENTS},"streamSettings":{"network":"tcp","security":"tls","tlsSettings":{"serverName":"$D","certificates":[{"certificateFile":"$CERT","keyFile":"$KEY"}],"alpn":["http/1.1"]}}}
  ],
  "outbounds": [{"tag":"direct","protocol":"freedom","settings":{"domainStrategy":"UseIP"}},{"tag":"block","protocol":"blackhole"}],
  "routing": {"domainStrategy":"IPIfNonMatch","rules":[{"type":"field","outboundTag":"block","protocol":["bittorrent"]},{"type":"field","outboundTag":"direct","network":"tcp,udp"}]}
}
EOF
  xray run -test -config "$XRAY_CONFIG" >/dev/null 2>&1 && systemctl restart xray >/dev/null 2>&1 || true
}

list_users(){
  header
  echo -e "${CYAN}VLESS:${NC}"
  cat "$XDB/vless.db" 2>/dev/null || echo "No users"
  echo ""
  echo -e "${CYAN}VMESS:${NC}"
  cat "$XDB/vmess.db" 2>/dev/null || echo "No users"
  echo ""
  echo -e "${CYAN}TROJAN:${NC}"
  cat "$XDB/trojan.db" 2>/dev/null || echo "No users"
  pause
}

delete_user(){
  header
  echo "[1] VLESS"
  echo "[2] VMESS"
  echo "[3] TROJAN"
  read -rp "Protocol: " P
  case "$P" in
    1) DB="$XDB/vless.db" ;;
    2) DB="$XDB/vmess.db" ;;
    3) DB="$XDB/trojan.db" ;;
    *) return ;;
  esac
  [ ! -f "$DB" ] && echo "No database." && pause && return
  nl -ba "$DB"
  read -rp "Line number: " N
  [ -z "$N" ] && return
  sed -i "${N}d" "$DB"
  configure_xray_v2ray_dns_quiet
  echo -e "${GREEN}Deleted.${NC}"
  pause
}

show_links_info(){
  header
  D="$(get_domain)"
  echo "VLESS TCP/TLS  : $D:$VLESS_PORT"
  echo "VMESS TCP/TLS  : $D:$VMESS_PORT"
  echo "TROJAN TCP/TLS : $D:$TROJAN_PORT"
  echo "DNS Server     : $(get_ip):53"
  echo ""
  echo "لا يوجد WebSocket ولا Path."
  pause
}

open_ports(){
  header
  ufw allow 22/tcp 2>/dev/null || true
  ufw allow 80/tcp 2>/dev/null || true
  ufw allow "$VLESS_PORT/tcp" 2>/dev/null || true
  ufw allow "$VMESS_PORT/tcp" 2>/dev/null || true
  ufw allow "$TROJAN_PORT/tcp" 2>/dev/null || true
  ufw allow 53/tcp 2>/dev/null || true
  ufw allow 53/udp 2>/dev/null || true
  echo -e "${GREEN}Ports opened.${NC}"
  pause
}

check_all(){
  header
  echo -e "${CYAN}=== SERVICES ===${NC}"
  echo "xray    : $(svc xray)"
  echo "dnsmasq : $(svc dnsmasq)"
  echo "nginx   : $(svc nginx)"
  echo ""
  echo -e "${CYAN}=== PORTS ===${NC}"
  ss -tulpn | grep -E ':53|:80|:443|:8443|:2083' || true
  echo ""
  echo -e "${CYAN}=== DNS TEST ===${NC}"
  D="$(get_domain)"
  [ "$D" != "Not Set" ] && dig @127.0.0.1 "$D" +short 2>/dev/null || true
  echo ""
  echo -e "${CYAN}=== XRAY CONFIG TEST ===${NC}"
  command -v xray >/dev/null 2>&1 && xray run -test -config "$XRAY_CONFIG" 2>&1 | tail -n 5 || true
  pause
}

auto_fix_v2ray_dns(){
  header
  echo -e "${YELLOW}Auto Fix V2Ray + DNS...${NC}"
  apt update -y
  apt install -y curl wget socat cron jq uuid-runtime openssl ca-certificates \
    nginx openssh-server dnsmasq dnsutils ufw psmisc iproute2 net-tools lsof \
    qrencode unzip certbot

  command -v xray >/dev/null 2>&1 || bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install

  configure_dns
  configure_nginx_80
  configure_xray_v2ray_dns
  open_ports
}

setting_menu(){
  while true; do
    header
    echo -e "${BLUE}[1]${NC} Install Base Packages"
    echo -e "${BLUE}[2]${NC} Install / Repair Xray"
    echo -e "${BLUE}[3]${NC} Set / Change Domain"
    echo -e "${BLUE}[4]${NC} Issue / Renew SSL"
    echo -e "${BLUE}[5]${NC} Configure DNS"
    echo -e "${BLUE}[6]${NC} Configure Nginx 80"
    echo -e "${BLUE}[7]${NC} Configure Xray V2Ray + DNS"
    echo -e "${BLUE}[8]${NC} Open Firewall Ports"
    echo -e "${BLUE}[9]${NC} Check All"
    echo -e "${BLUE}[10]${NC} Auto Fix V2Ray + DNS"
    echo -e "${BLUE}[0]${NC} Back"
    echo -e "${PURPLE}────────────────────────────────────────────────────${NC}"
    read -rp "Select: " S
    case "$S" in
      1) install_base ;;
      2) install_xray ;;
      3) set_domain ;;
      4) issue_ssl ;;
      5) configure_dns ;;
      6) configure_nginx_80 ;;
      7) configure_xray_v2ray_dns ;;
      8) open_ports ;;
      9) check_all ;;
      10) auto_fix_v2ray_dns ;;
      0) return ;;
      *) ;;
    esac
  done
}

dns_menu(){
  while true; do
    header
    echo -e "${BLUE}[1]${NC} Add DNS Record"
    echo -e "${BLUE}[2]${NC} List DNS Records"
    echo -e "${BLUE}[3]${NC} Delete DNS Record"
    echo -e "${BLUE}[4]${NC} Apply DNS Config"
    echo -e "${BLUE}[0]${NC} Back"
    echo -e "${PURPLE}────────────────────────────────────────────────────${NC}"
    read -rp "Select: " D
    case "$D" in
      1) add_dns_record ;;
      2) list_dns_records ;;
      3) delete_dns_record ;;
      4) configure_dns ;;
      0) return ;;
      *) ;;
    esac
  done
}

main_menu(){
  while true; do
    header
    echo -e "${BLUE}[1]${NC} Create VLESS TCP/TLS"
    echo -e "${BLUE}[2]${NC} Create VMESS TCP/TLS"
    echo -e "${BLUE}[3]${NC} Create TROJAN TCP/TLS"
    echo -e "${BLUE}[4]${NC} List Users"
    echo -e "${BLUE}[5]${NC} Delete User"
    echo -e "${BLUE}[6]${NC} DNS Manager"
    echo -e "${BLUE}[7]${NC} Show Connection Info"
    echo -e "${BLUE}[8]${NC} Check All"
    echo -e "${BLUE}[9]${NC} Restart Services"
    echo -e "${BLUE}[10]${NC} Setting"
    echo -e "${BLUE}[0]${NC} Exit"
    echo -e "${PURPLE}────────────────────────────────────────────────────${NC}"
    read -rp "Select: " M
    case "$M" in
      1) create_user vless ;;
      2) create_user vmess ;;
      3) create_user trojan ;;
      4) list_users ;;
      5) delete_user ;;
      6) dns_menu ;;
      7) show_links_info ;;
      8) check_all ;;
      9) systemctl restart xray dnsmasq nginx 2>/dev/null || true; pause ;;
      10) setting_menu ;;
      0) exit 0 ;;
      *) ;;
    esac
  done
}

case "$1" in
  install)
    install_menu_command
  ;;
  menu|"")
    install_menu_command
    main_menu
  ;;
  *)
    main_menu
  ;;
esac

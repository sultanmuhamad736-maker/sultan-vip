}

full_server_stats_menu(){
  local ACTION SSH_TODAY SSH_MONTH SSH_TOTAL XRAY_TODAY XRAY_MONTH XRAY_TOTAL TOTAL_TODAY TOTAL_MONTH TOTAL_TOTAL
  local SSH_ONLINE XRAY_ONLINE TOTAL_ONLINE SSH_PEAK VMESS_PEAK VLESS_PEAK TROJAN_PEAK TOTAL_PEAK

  while true; do
    quota_sync
    xray_stats_sync

    SSH_TODAY="$(stats_number "$(ssh_traffic_today_bytes)")"
    SSH_MONTH="$(stats_number "$(ssh_traffic_month_bytes)")"
    SSH_TOTAL="$(stats_number "$(ssh_traffic_total_bytes)")"
    XRAY_TODAY="$(stats_number "$(xray_all_traffic_today_bytes)")"
    XRAY_MONTH="$(stats_number "$(xray_all_traffic_month_bytes)")"
    XRAY_TOTAL="$(stats_number "$(xray_all_traffic_total_bytes)")"
    TOTAL_TODAY="$((SSH_TODAY + XRAY_TODAY))"
    TOTAL_MONTH="$((SSH_MONTH + XRAY_MONTH))"
    TOTAL_TOTAL="$((SSH_TOTAL + XRAY_TOTAL))"

    SSH_ONLINE="$(stats_number "$(total_online_logins)")"
    XRAY_ONLINE="$(stats_number "$(xray_all_current_users)")"
    TOTAL_ONLINE="$((SSH_ONLINE + XRAY_ONLINE))"
    SSH_PEAK="$(stats_number "$(ssh_peak_users_today)")"
    VMESS_PEAK="$(stats_number "$(xray_protocol_peak_today vmess-ws)")"
    VLESS_PEAK="$(stats_number "$(xray_protocol_peak_today vless-ws)")"
    TROJAN_PEAK="$(stats_number "$(xray_protocol_peak_today trojan-ws)")"
    TOTAL_PEAK="$((SSH_PEAK + VMESS_PEAK + VLESS_PEAK + TROJAN_PEAK))"

    refresh_screen
    echo "----------------------------------------"
    echo "Full Server Stats"
    echo "----------------------------------------"
    printf "%-22s : %s / Unlimited\n" "Traffic Today" "$(human_bytes "$TOTAL_TODAY")"
    printf "%-22s : %s / Unlimited\n" "Traffic This Month" "$(human_bytes "$TOTAL_MONTH")"
    printf "%-22s : %s / Unlimited\n" "Total Traffic" "$(human_bytes "$TOTAL_TOTAL")"
    echo "----------------------------------------"
    printf "%-22s : %s / Unlimited\n" "SSH Traffic" "$(human_bytes "$SSH_TOTAL")"
    printf "%-22s : %s / Unlimited\n" "V2Ray Traffic" "$(human_bytes "$XRAY_TOTAL")"
    echo "----------------------------------------"
    printf "%-22s : %s\n" "SSH Users" "$(count_ssh)"
    printf "%-22s : %s\n" "VMESS Users" "$(count_vmess)"
    printf "%-22s : %s\n" "VLESS Users" "$(count_vless)"
    printf "%-22s : %s\n" "Trojan Users" "$(count_trojan)"
    echo "----------------------------------------"
    printf "%-22s : %s / Unlimited\n" "Max Users Today" "$TOTAL_PEAK"
    printf "%-22s : %s / Unlimited\n" "Current Online Users" "$TOTAL_ONLINE"
    printf "%-22s : %s / Unlimited\n" "SSH Online Users" "$SSH_ONLINE"
    printf "%-22s : %s / Unlimited\n" "V2Ray Online Users" "$XRAY_ONLINE"
    echo "----------------------------------------"
    printf "%-22s : %s\n" "RAM" "$(get_ram)"
    printf "%-22s : %s\n" "Disk" "$(get_disk)"
    printf "%-22s : %s\n" "Uptime" "$(get_uptime)"
    printf "%-22s : %s\n" "Load" "$(uptime | awk -F'load average: ' '{print $2}')"
    echo "----------------------------------------"
    echo "1 - Live Server Traffic"
    echo "2 - Live SSH Traffic"
    echo "3 - Live V2Ray Traffic"
    echo "4 - All Online Users"
    echo "5 - SSH Online Users"
    echo "6 - V2Ray Online Users"
    echo "0 - Back"
    echo "----------------------------------------"
    read -p "Select: " ACTION

    case "$ACTION" in
      1) live_traffic_view all "" SERVER ;;
      2) live_traffic_view ssh "" SSH ;;
      3) live_traffic_view xray-all "" V2RAY ;;
      4) online_users_view all "ALL ONLINE USERS - FIRST LOGIN TO LAST" ;;
      5) online_users_view ssh "SSH ONLINE USERS - FIRST LOGIN TO LAST" ;;
      6) online_users_view xray "V2RAY ONLINE USERS - FIRST LOGIN TO LAST" ;;
      0) return ;;
    esac
  done
}

online_all_users_menu(){
  online_users_view all "ALL ONLINE USERS - FIRST LOGIN TO LAST"
}

online_ssh_users_menu(){
  online_users_view ssh "SSH ONLINE USERS - FIRST LOGIN TO LAST"
}

online_xray_users_menu(){
  local PROTO="$1" TAG="$2"
  online_users_view xray "${PROTO^^} ONLINE USERS - FIRST LOGIN TO LAST" "$TAG"
}

backup_menu(){
  refresh_screen
  echo "[1] Create Backup"
  echo "[2] Restore Backup"
  read -p "Select: " b
  case "$b" in
    1)
      mkdir -p /root/sultan-backup
      BP="/root/sultan-backup/sultan-$(date +%F-%H%M).tar.gz"
      tar -czf "$BP" \
        /etc/sultan /usr/local/etc/xray /usr/local/bin/menu \
        /usr/local/bin/sultan-ssh-ws /usr/local/bin/sultan-udp-relay \
        /usr/local/sbin/sultan-login-limit /usr/local/sbin/sultan-quota-sync /usr/local/sbin/sultan-xray-stats-sync /usr/local/sbin/sultan-xray-limit-enforcer /usr/local/sbin/sultan-tunnel-shell \
        /etc/systemd/system/sultan-ws.service /etc/systemd/system/udp-custom.service \
        /etc/systemd/system/sultan-quota.service /etc/systemd/system/sultan-quota.timer \
        /etc/systemd/system/sultan-xray-stats.service /etc/systemd/system/sultan-xray-stats.timer /etc/systemd/system/sultan-xray-limit-enforcer.service /etc/systemd/system/sultan-xray-limit-enforcer.timer \
        /etc/nginx/conf.d/sultan-ready.conf /etc/haproxy/haproxy.cfg \
        /etc/ssh/sshd_config.d/98-sultan-legacy-login.conf /etc/ssh/sshd_config.d/99-sultan-users.conf /etc/fail2ban/jail.d/sultan-sshd.conf \
        /etc/sysctl.d/99-sultan-bbr.conf /etc/sysctl.d/97-sultan-fast-network.conf 2>/dev/null ||
        { echo "Backup failed."; pause; return; }
      chmod 600 "$BP"
      echo "Backup created: $BP"
      pause
      ;;
    2)
      read -p "Backup path: " BP
      [ -f "$BP" ] || { echo "Backup file not found."; pause; return; }
      tar -tzf "$BP" >/dev/null || { echo "Invalid backup archive."; pause; return; }
      tar -xzf "$BP" -C / || { echo "Restore failed."; pause; return; }
      systemctl daemon-reload
      quota_sync
      echo "Restore completed. Review services before production use."
      pause
      ;;
  esac
}

bot_menu(){
  refresh_screen
  echo "[1] Save Bot Token"
  echo "[2] Save Chat ID"
  echo "[3] Test Message"
  read -p "Select: " b
  case "$b" in
    1) read -r -s -p "Bot Token: " T; echo ""; printf '%s\n' "$T" > "$BASE/bot_token"; chmod 600 "$BASE/bot_token" ;;
    2) read -p "Chat ID: " C; printf '%s\n' "$C" > "$BASE/chat_id"; chmod 600 "$BASE/chat_id" ;;
    3)
      T="$(cat "$BASE/bot_token" 2>/dev/null)"
      C="$(cat "$BASE/chat_id" 2>/dev/null)"
      [ -n "$T" ] && [ -n "$C" ] || { echo "Token or Chat ID missing."; pause; return; }
      curl -fsS "https://api.telegram.org/bot$T/sendMessage" -d chat_id="$C" -d text="SULTAN Panel Test"
      ;;
  esac
  pause
}

confirm_service_action(){
  local MSG="$1" C
  echo "$MSG"
  read -p "Type YES to continue: " C
  [ "$C" = "YES" ]
}

service_unit_exists(){
  local S="$1"
  systemctl cat "$S.service" >/dev/null 2>&1 || systemctl cat "$S" >/dev/null 2>&1
}

service_control_menu(){
  while true; do
    refresh_screen
    echo "========================================"
    echo "          SERVICE CONTROL MENU"
    echo "========================================"
    echo "[1]  Nginx Menu"
    echo "[2]  HAProxy Menu"
    echo "[3]  UDP Menu"
    echo "[4]  WebSocket Menu"
    echo "[5]  SSL/TLS Menu"
    echo "[6]  BBR Menu"
    echo "[7]  Fail2Ban Menu"
    echo "[8]  Port Menu"
    echo "[9]  Xray Menu"
    echo "[10] Restart All Server"
    echo "[0]  Back"
    echo "========================================"
    read -p "Select: " sc
    case "$sc" in
      1) service_item_menu "Nginx" nginx ;;
      2) service_item_menu "HAProxy" haproxy ;;
      3) service_item_menu "UDP" udp ;;
      4) service_item_menu "WebSocket" websocket ;;
      5) service_item_menu "SSL/TLS" ssltls ;;
      6) service_item_menu "BBR" bbr ;;
      7) service_item_menu "Fail2Ban" fail2ban ;;
      8) service_item_menu "Port" port ;;
      9) service_item_menu "Xray" xray ;;
      10) reinstall_all_server_mini ;;
      0) return ;;
      *) echo "Invalid option"; sleep 1 ;;
    esac
  done
}

service_item_menu(){
  local TITLE="$1" KEY="$2" A
  while true; do
    refresh_screen
    echo "========================================"
    echo "              $TITLE MENU"
    echo "========================================"
    echo "[1] Stop"
    echo "[2] Reinstall"
    echo "[3] Delete"
    echo "[0] Back"
    echo "========================================"
    read -p "Select: " A
    case "$A" in
      1) service_stop_action "$KEY"; pause ;;
      2) service_reinstall_action "$KEY"; pause ;;
      3) service_delete_action "$KEY"; pause ;;
      0) return ;;
      *) echo "Invalid option"; sleep 1 ;;
    esac
  done
}

service_stop_action(){
  local KEY="$1"
  refresh_screen
  case "$KEY" in
    nginx)
      echo "Stopping Nginx..."
      if current_session_via_ws; then
        confirm_service_action "Stopping Nginx may disconnect your current WebSocket SSH session." || { echo "Cancelled."; return; }
      fi
      systemctl stop nginx 2>/dev/null || true
      systemctl status nginx --no-pager -l 2>/dev/null || true
      ;;
    haproxy)
      echo "Stopping HAProxy..."
      if current_session_via_ws; then
        confirm_service_action "Stopping HAProxy may disconnect your current WebSocket SSH session." || { echo "Cancelled."; return; }
      fi
      systemctl stop haproxy 2>/dev/null || true
      systemctl status haproxy --no-pager -l 2>/dev/null || true
      ;;
    udp)
      echo "Stopping UDP Custom..."
      systemctl stop udp-custom 2>/dev/null || true
      systemctl status udp-custom --no-pager -l 2>/dev/null || true
      ;;
    websocket)
      echo "Stopping WebSocket..."
      if current_session_via_ws; then
        confirm_service_action "Stopping WebSocket may disconnect your current SSH session." || { echo "Cancelled."; return; }
      fi
      systemctl stop sultan-ws 2>/dev/null || true
      systemctl status sultan-ws --no-pager -l 2>/dev/null || true
      ;;
    ssltls)
      confirm_service_action "Stopping SSL/TLS endpoint will stop Nginx and HAProxy. This can disconnect clients." || { echo "Cancelled."; return; }
      systemctl stop haproxy 2>/dev/null || true
      systemctl stop nginx 2>/dev/null || true
      echo "SSL/TLS endpoint stopped."
      ;;
    bbr)
      echo "Disabling BBR..."
      rm -f /etc/sysctl.d/99-sultan-bbr.conf
      sed -i '/net.core.default_qdisc=fq/d;/net.ipv4.tcp_congestion_control=bbr/d' /etc/sysctl.conf 2>/dev/null || true
      if sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw cubic; then
        sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1 || true
      fi
      sysctl -w net.core.default_qdisc=fq_codel >/dev/null 2>&1 || true
      sysctl --system >/dev/null 2>&1 || true
      echo "BBR stopped/disabled."
      ;;
    fail2ban)
      echo "Stopping Fail2Ban..."
      systemctl stop fail2ban 2>/dev/null || true
      systemctl status fail2ban --no-pager -l 2>/dev/null || true
      ;;
    port)
      confirm_service_action "This will close public VPN ports in UFW rules. SSH port will not be touched." || { echo "Cancelled."; return; }
      if command -v ufw >/dev/null 2>&1; then
        for P in 80/tcp 443/tcp 8080/tcp 7300/udp; do
          ufw delete allow "$P" >/dev/null 2>&1 || true
          ufw deny "$P" >/dev/null 2>&1 || true
        done
        ufw reload >/dev/null 2>&1 || true
        ufw status verbose || true
      else
        echo "UFW is not installed."
      fi
      ;;
    xray)
      echo "Stopping Xray..."
      systemctl stop xray 2>/dev/null || true
      systemctl status xray --no-pager -l 2>/dev/null || true
      ;;
  esac
}

service_reinstall_action(){
  local KEY="$1" D FILES CERT KEYFILE TOKEN
  refresh_screen
  case "$KEY" in
    nginx)
      echo "Reinstalling Nginx..."
      apt-get update -y
      apt-get install -y --reinstall nginx
      if validate_domain "$(get_domain)"; then
        refresh_proxy_config_from_current || true
      else
        nginx -t && checked_restart nginx || true
      fi
      systemctl status nginx --no-pager -l 2>/dev/null || true
      ;;
    haproxy)
      echo "Reinstalling HAProxy..."
      apt-get update -y
      apt-get install -y --reinstall haproxy
      if validate_domain "$(get_domain)"; then
        refresh_proxy_config_from_current || true
      else
        haproxy -c -f /etc/haproxy/haproxy.cfg && checked_restart haproxy || true
      fi
      systemctl status haproxy --no-pager -l 2>/dev/null || true
      ;;
    udp)
      echo "Reinstalling UDP Custom..."
      install_udp
      systemctl status udp-custom --no-pager -l 2>/dev/null || true
      ;;
    websocket)
      echo "Reinstalling WebSocket..."
      install_ws
      systemctl status sultan-ws --no-pager -l 2>/dev/null || true
      ;;
    ssltls)
      echo "Reinstalling SSL/TLS setup..."
      setup_ready
      ;;
    bbr)
      echo "Reinstalling BBR..."
      modprobe tcp_bbr 2>/dev/null || true
      cat >/etc/sysctl.d/99-sultan-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
      sysctl -p /etc/sysctl.d/99-sultan-bbr.conf || sysctl --system || true
      sysctl net.ipv4.tcp_congestion_control 2>/dev/null || true
      ;;
    fail2ban)
      echo "Reinstalling Fail2Ban..."
      apt-get update -y
      apt-get install -y --reinstall fail2ban
      write_sultan_fail2ban_jail
      systemctl daemon-reload
      systemctl enable fail2ban >/dev/null 2>&1 || true
      checked_restart fail2ban || true
      systemctl status fail2ban --no-pager -l 2>/dev/null || true
      ;;
    port)
      echo "Opening main ports..."
      open_main_ports
      ufw status verbose 2>/dev/null || true
      ;;
    xray)
      echo "Reinstalling Xray..."
      install_xray --quiet || true
      create_xray_config --quiet || true
      xray_restart_safe || true
      systemctl status xray --no-pager -l 2>/dev/null || true
      ;;
  esac
}

service_delete_action(){
  local KEY="$1" D
  refresh_screen
  case "$KEY" in
    nginx)
      confirm_service_action "Delete Nginx completely? This can stop all TLS/WebSocket traffic." || { echo "Cancelled."; return; }
      systemctl disable --now nginx 2>/dev/null || true
      apt-get purge -y nginx nginx-common nginx-core nginx-full 2>/dev/null || apt-get remove -y nginx 2>/dev/null || true
      rm -rf /etc/nginx
      systemctl daemon-reload
      echo "Nginx deleted."
      ;;
    haproxy)
      confirm_service_action "Delete HAProxy completely? This can stop port 443 routing." || { echo "Cancelled."; return; }
      systemctl disable --now haproxy 2>/dev/null || true
      apt-get purge -y haproxy 2>/dev/null || apt-get remove -y haproxy 2>/dev/null || true
      rm -rf /etc/haproxy
      systemctl daemon-reload
      echo "HAProxy deleted."
      ;;
    udp)
      confirm_service_action "Delete UDP Custom completely?" || { echo "Cancelled."; return; }
      systemctl disable --now udp-custom 2>/dev/null || true
      rm -f /etc/systemd/system/udp-custom.service /usr/local/bin/sultan-udp-relay
      userdel sultan-udp 2>/dev/null || true
      groupdel sultan-udp 2>/dev/null || true
      systemctl daemon-reload
      echo "UDP Custom deleted."
      ;;
    websocket)
      confirm_service_action "Delete WebSocket completely? This can disconnect SSH over WebSocket." || { echo "Cancelled."; return; }
      systemctl disable --now sultan-ws 2>/dev/null || true
      rm -f /etc/systemd/system/sultan-ws.service /usr/local/bin/sultan-ssh-ws
      userdel sultan-ws 2>/dev/null || true
      groupdel sultan-ws 2>/dev/null || true
      systemctl daemon-reload
      echo "WebSocket deleted."
      ;;
    ssltls)
      D="$(get_domain)"
      validate_domain "$D" || { echo "No valid domain saved."; return; }
      confirm_service_action "Delete SSL/TLS certificate files for $D?" || { echo "Cancelled."; return; }
      certbot delete --cert-name "$D" --non-interactive 2>/dev/null || true
      rm -rf "/etc/sultan/selfsigned/$D"
      echo "SSL/TLS certificate files deleted for $D."
      ;;
    bbr)
      confirm_service_action "Delete BBR configuration?" || { echo "Cancelled."; return; }
      rm -f /etc/sysctl.d/99-sultan-bbr.conf
      sed -i '/net.core.default_qdisc=fq/d;/net.ipv4.tcp_congestion_control=bbr/d' /etc/sysctl.conf 2>/dev/null || true
      if sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw cubic; then
        sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1 || true
      fi
      sysctl -w net.core.default_qdisc=fq_codel >/dev/null 2>&1 || true
      sysctl --system >/dev/null 2>&1 || true
      echo "BBR deleted/disabled."
      ;;
    fail2ban)
      confirm_service_action "Delete Fail2Ban completely?" || { echo "Cancelled."; return; }
      systemctl disable --now fail2ban 2>/dev/null || true
      apt-get purge -y fail2ban 2>/dev/null || apt-get remove -y fail2ban 2>/dev/null || true
      rm -rf /etc/fail2ban
      systemctl daemon-reload
      echo "Fail2Ban deleted."
      ;;
    port)
      confirm_service_action "Delete public VPN port rules from UFW? SSH port will not be touched." || { echo "Cancelled."; return; }
      if command -v ufw >/dev/null 2>&1; then
        for P in 80/tcp 443/tcp 8080/tcp 7300/udp; do
          ufw delete allow "$P" >/dev/null 2>&1 || true
          ufw delete deny "$P" >/dev/null 2>&1 || true
        done
        ufw reload >/dev/null 2>&1 || true
        ufw status verbose || true
      fi
      echo "Public VPN port rules deleted from UFW."
      ;;
    xray)
      confirm_service_action "Delete Xray completely? This removes Xray binary, config, and service." || { echo "Cancelled."; return; }
      systemctl disable --now xray 2>/dev/null || true
      rm -f /etc/systemd/system/xray.service /etc/systemd/system/xray@.service
      rm -f /usr/local/bin/xray
      rm -rf /usr/local/etc/xray /usr/local/share/xray /var/log/xray
      systemctl daemon-reload
      echo "Xray deleted."
      ;;
  esac
}

reinstall_all_server_mini(){
  refresh_screen
  echo "========================================"
  echo "          RESTART / REINSTALL SERVER"
  echo "========================================"
  echo "This will run:"
  echo "bash <(curl -fsSL https://raw.githubusercontent.com/sultanmuhamad736-maker/sultan-vip/main/install-mini.sh)"
  echo ""
  confirm_service_action "This will reinstall the server setup." || { echo "Cancelled."; pause; return; }
  bash <(curl -fsSL https://raw.githubusercontent.com/sultanmuhamad736-maker/sultan-vip/main/install-mini.sh)
  pause
}

purge_all_vpn_components(){
  local REPORT VPN_DOMAIN TYPE UNIT PKG DEV TABLE FAMILY NAME CURRENT_DEV RULES_TMP
  local VPN_MATCH='vpn|openvpn|wireguard|wg-quick|strongswan|charon|ipsec|libreswan|xl2tpd|pptpd|ocserv|softether|vpnserver|vpnbridge|vpnclient|tailscale|zerotier|hysteria|sing-box|v2ray|xray|trojan|shadowsocks|badvpn|udpgw|clash|mihomo|gost|brook|tuic|naiveproxy|headscale|tinc|nebula|openconnect|vpnc|sshuttle|outline|nordvpn|mullvad|protonvpn|surfshark|cloudflare-warp|warp-svc|sultan'

  REPORT="/root/sultan-remove-report-$(date +%Y%m%d-%H%M%S).log"
  VPN_DOMAIN="$(head -n1 /etc/sultan/domain 2>/dev/null | tr -d '\r[:space:]')"
  echo "Full VPN cleanup started. Report: $REPORT"
  printf 'Started: %s\n' "$(date -Is 2>/dev/null || date)" > "$REPORT"

  # Stop and disable every known VPN/tunnel/SULTAN systemd unit, including
  # units that were not installed by this script.
  for TYPE in service socket timer path; do
    while IFS= read -r UNIT; do
      [ -n "$UNIT" ] || continue
      echo "systemd: $UNIT" >> "$REPORT"
      systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
    done < <(
      {
        systemctl list-unit-files --type="$TYPE" --no-legend 2>/dev/null | awk '{print $1}'
        systemctl list-units --all --type="$TYPE" --no-legend 2>/dev/null | awk '{print $1}'
      } | grep -Ei "$VPN_MATCH" | sort -u
    )
  done

  # Stop common standalone tunnel processes left outside systemd.
  for NAME in openvpn openvpn3 wireguard-go wg-quick charon charon-systemd pluto starter ipsec xl2tpd pptpd ocserv vpnserver vpnbridge vpnclient tailscaled zerotier-one hysteria sing-box v2ray xray trojan ss-server ss-local ss-tunnel sslocal ssserver badvpn-udpgw clash mihomo gost brook tuic-server tuic-client naive headscale tincd nebula openconnect vpnc sshuttle warp-svc; do
    pkill -TERM -x "$NAME" 2>/dev/null || true
  done
  sleep 1
  for NAME in openvpn openvpn3 wireguard-go wg-quick charon charon-systemd pluto starter ipsec xl2tpd pptpd ocserv vpnserver vpnbridge vpnclient tailscaled zerotier-one hysteria sing-box v2ray xray trojan ss-server ss-local ss-tunnel sslocal ssserver badvpn-udpgw clash mihomo gost brook tuic-server tuic-client naive headscale tincd nebula openconnect vpnc sshuttle warp-svc; do
    pkill -KILL -x "$NAME" 2>/dev/null || true
  done

  # Delete VPN containers, images, networks and volumes when Docker/Podman is present.
  if command -v docker >/dev/null 2>&1; then
    docker ps -a --format '{{.ID}}|{{.Names}}|{{.Image}}' 2>/dev/null | grep -Ei "$VPN_MATCH" | cut -d'|' -f1 | xargs -r docker rm -f >/dev/null 2>&1 || true
    docker images --format '{{.ID}}|{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -Ei "$VPN_MATCH" | cut -d'|' -f1 | sort -u | xargs -r docker image rm -f >/dev/null 2>&1 || true
    docker network ls --format '{{.ID}}|{{.Name}}' 2>/dev/null | grep -Ei "$VPN_MATCH" | cut -d'|' -f1 | xargs -r docker network rm >/dev/null 2>&1 || true
    docker volume ls --format '{{.Name}}' 2>/dev/null | grep -Ei "$VPN_MATCH" | xargs -r docker volume rm -f >/dev/null 2>&1 || true
  fi
  if command -v podman >/dev/null 2>&1; then
    podman ps -a --format '{{.ID}}|{{.Names}}|{{.Image}}' 2>/dev/null | grep -Ei "$VPN_MATCH" | cut -d'|' -f1 | xargs -r podman rm -f >/dev/null 2>&1 || true
    podman images --format '{{.ID}}|{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -Ei "$VPN_MATCH" | cut -d'|' -f1 | sort -u | xargs -r podman image rm -f >/dev/null 2>&1 || true
    podman network ls --format '{{.ID}}|{{.Name}}' 2>/dev/null | grep -Ei "$VPN_MATCH" | cut -d'|' -f1 | xargs -r podman network rm -f >/dev/null 2>&1 || true
    podman volume ls --format '{{.Name}}' 2>/dev/null | grep -Ei "$VPN_MATCH" | xargs -r podman volume rm -f >/dev/null 2>&1 || true
  fi

  # Remove NetworkManager VPN and WireGuard connection profiles.
  if command -v nmcli >/dev/null 2>&1; then
    nmcli -t -f UUID,TYPE connection show 2>/dev/null | awk -F: '$2=="vpn" || $2=="wireguard" {print $1}' | while IFS= read -r NAME; do
      [ -n "$NAME" ] && nmcli connection delete uuid "$NAME" >/dev/null 2>&1 || true
    done
  fi

  # Purge all installed packages whose package names identify VPN/tunnel software.
  mapfile -t VPN_PACKAGES < <(
    dpkg-query -W -f='${binary:Package}\n' 2>/dev/null |
      grep -Ei "$VPN_MATCH|network-manager-(l2tp|openconnect|strongswan|vpnc)|cloudflare-warp|warp-cli" |
      sort -u
  )
  if [ "${#VPN_PACKAGES[@]}" -gt 0 ]; then
    printf 'Packages purged:\n%s\n' "${VPN_PACKAGES[*]}" >> "$REPORT"
    apt-get purge -y "${VPN_PACKAGES[@]}" >/dev/null 2>&1 || true
  fi

  if command -v snap >/dev/null 2>&1; then
    snap list 2>/dev/null | awk 'NR>1 {print $1}' | grep -Ei "$VPN_MATCH" | while IFS= read -r PKG; do
      [ -n "$PKG" ] && snap remove --purge "$PKG" >/dev/null 2>&1 || true
    done
  fi

  # Remove known VPN/tunnel configuration, state, binaries and service leftovers.
  rm -rf \
    /etc/openvpn /usr/local/etc/openvpn /var/lib/openvpn /var/log/openvpn* /run/openvpn* \
    /etc/wireguard /usr/local/etc/wireguard /var/lib/wireguard \
    /etc/ipsec.conf /etc/ipsec.secrets /etc/ipsec.d /etc/strongswan* /var/lib/strongswan /var/log/strongswan* \
    /etc/xl2tpd /etc/pptpd.conf /etc/ppp/options.xl2tpd /etc/ppp/options.pptpd \
    /etc/ocserv /var/lib/ocserv /var/log/ocserv* \
    /etc/softether /usr/local/vpnserver /opt/vpnserver /var/lib/softether* \
    /etc/tailscale /var/lib/tailscale /var/cache/tailscale \
    /etc/zerotier-one /var/lib/zerotier-one \
    /etc/hysteria /usr/local/etc/hysteria /var/lib/hysteria /var/log/hysteria* \
    /etc/v2ray /usr/local/etc/v2ray /var/lib/v2ray /var/log/v2ray* \
    /etc/xray /usr/local/etc/xray /var/lib/xray /var/log/xray* /usr/local/share/xray \
    /etc/sing-box /usr/local/etc/sing-box /var/lib/sing-box /var/log/sing-box* \
    /etc/trojan /etc/trojan-go /usr/local/etc/trojan* /var/lib/trojan* /var/log/trojan* \
    /etc/shadowsocks* /usr/local/etc/shadowsocks* /var/lib/shadowsocks* /var/log/shadowsocks* \
    /etc/badvpn /var/lib/badvpn /var/log/badvpn* \
    /etc/clash /root/.config/clash /etc/mihomo /root/.config/mihomo \
    /etc/headscale /var/lib/headscale /etc/tinc /var/lib/tinc /etc/nebula /var/lib/nebula \
    /etc/outline /var/lib/outline /opt/outline* \
    /etc/warp /var/lib/cloudflare-warp /etc/cloudflare-warp \
    /etc/sultan /var/lib/sultan /var/cache/sultan /var/log/sultan* \
    2>/dev/null || true

  rm -f \
    /usr/local/bin/openvpn* /usr/local/sbin/openvpn* /usr/local/bin/wireguard-go /usr/local/bin/wg /usr/local/bin/wg-quick \
    /usr/local/bin/hysteria* /usr/local/bin/sing-box /usr/local/bin/v2ray /usr/local/bin/xray \
    /usr/local/bin/trojan* /usr/local/bin/ss-* /usr/local/bin/badvpn* /usr/local/bin/clash* /usr/local/bin/mihomo* \
    /usr/local/bin/gost* /usr/local/bin/brook* /usr/local/bin/tuic* /usr/local/bin/naive* /usr/local/bin/nebula* \
    /usr/local/bin/headscale* /usr/local/bin/tailscale* /usr/local/bin/zerotier* \
    /usr/local/bin/sultan-* /usr/local/sbin/sultan-* /usr/local/bin/menu \
    2>/dev/null || true

  # Remove all remaining names containing VPN/tunnel product identifiers from
  # system/configuration trees and user homes. This intentionally includes
  # components installed outside this script, but avoids virtual filesystems.
  for NAME in /etc /usr/local /opt /var/lib /var/cache /var/log /root /home; do
    [ -d "$NAME" ] || continue
    find "$NAME" -xdev -depth -mindepth 1 \
      \( -iname '*vpn*' -o -iname '*openvpn*' -o -iname '*wireguard*' -o -iname '*strongswan*' \
         -o -iname '*ipsec*' -o -iname '*tailscale*' -o -iname '*zerotier*' -o -iname '*hysteria*' \
         -o -iname '*v2ray*' -o -iname '*xray*' -o -iname '*trojan*' -o -iname '*shadowsocks*' \
         -o -iname '*badvpn*' -o -iname '*udpgw*' -o -iname '*sing-box*' -o -iname '*softether*' \
         -o -iname '*sultan*' \) -print0 2>/dev/null |
      while IFS= read -r -d '' PKG; do
        [ "$PKG" = "$REPORT" ] && continue
        printf 'path: %s\n' "$PKG" >> "$REPORT"
        rm -rf -- "$PKG" 2>/dev/null || true
      done
  done

  # Remove matching cron and startup entries, including entries created by
  # unrelated VPN installers.
  for PKG in /etc/crontab /etc/rc.local /var/spool/cron/crontabs/* /var/spool/cron/*; do
    [ -f "$PKG" ] || continue
    RULES_TMP="$(mktemp)" || continue
    grep -viE "$VPN_MATCH" "$PKG" > "$RULES_TMP" 2>/dev/null || true
    cat "$RULES_TMP" > "$PKG" 2>/dev/null || true
    rm -f "$RULES_TMP"
  done

  # Remove VPN-specific firewall tables/chains/rules while leaving unrelated
  # firewall and SSH rules intact.
  if command -v nft >/dev/null 2>&1; then
    while read -r TABLE FAMILY NAME; do
      [ "$TABLE" = "table" ] || continue
      printf '%s\n' "$NAME" | grep -Eqi "$VPN_MATCH" || continue
      nft delete table "$FAMILY" "$NAME" >/dev/null 2>&1 || true
    done < <(nft list tables 2>/dev/null)
  fi
  for TABLE in filter nat mangle raw security; do
    for NAME in ts-input ts-forward ts-postrouting sultan_quota sultan_limits openvpn wireguard vpn; do
      iptables -t "$TABLE" -D INPUT -j "$NAME" >/dev/null 2>&1 || true
      iptables -t "$TABLE" -D OUTPUT -j "$NAME" >/dev/null 2>&1 || true
      iptables -t "$TABLE" -D FORWARD -j "$NAME" >/dev/null 2>&1 || true
      iptables -t "$TABLE" -D PREROUTING -j "$NAME" >/dev/null 2>&1 || true
      iptables -t "$TABLE" -D POSTROUTING -j "$NAME" >/dev/null 2>&1 || true
      iptables -t "$TABLE" -F "$NAME" >/dev/null 2>&1 || true
      iptables -t "$TABLE" -X "$NAME" >/dev/null 2>&1 || true
      ip6tables -t "$TABLE" -D INPUT -j "$NAME" >/dev/null 2>&1 || true
      ip6tables -t "$TABLE" -D OUTPUT -j "$NAME" >/dev/null 2>&1 || true
      ip6tables -t "$TABLE" -D FORWARD -j "$NAME" >/dev/null 2>&1 || true
      ip6tables -t "$TABLE" -F "$NAME" >/dev/null 2>&1 || true
      ip6tables -t "$TABLE" -X "$NAME" >/dev/null 2>&1 || true
    done
  done
  if command -v ufw >/dev/null 2>&1; then
    for PKG in 1194/tcp 1194/udp 51820/udp 500/udp 4500/udp 1701/udp 1723/tcp 7300/udp 36712/udp 8388/tcp 8388/udp; do
      ufw --force delete allow "$PKG" >/dev/null 2>&1 || true
      ufw --force delete deny "$PKG" >/dev/null 2>&1 || true
    done
    ufw reload >/dev/null 2>&1 || true
  fi

  # Remove live VPN interfaces and IPsec state. The interface carrying the
  # current SSH session is left until reboot so cleanup can finish safely.
  CURRENT_DEV=""
  if [ -n "${SSH_CONNECTION%% *}" ]; then
    CURRENT_DEV="$(ip route get "${SSH_CONNECTION%% *}" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')"
  fi
  while IFS= read -r DEV; do
    [ -n "$DEV" ] || continue
    [ "$DEV" = "$CURRENT_DEV" ] && continue
    ip link set "$DEV" down >/dev/null 2>&1 || true
    ip link delete "$DEV" >/dev/null 2>&1 || true
  done < <(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep -Ei '^(tun|tap|wg|vpn|tailscale|zt|ipsec|ppp)')
  ip xfrm state flush >/dev/null 2>&1 || true
  ip xfrm policy flush >/dev/null 2>&1 || true

  # Remove VPN/SULTAN service accounts only when they are system or nologin
  # accounts; normal interactive users are not deleted by name matching.
  getent passwd | awk -F: '$1!="root" && ($3<1000 || $7 ~ /(nologin|false)$/) {print $1}' | grep -Ei "$VPN_MATCH" | while IFS= read -r NAME; do
    [ -n "$NAME" ] && userdel -r "$NAME" >/dev/null 2>&1 || true
  done
  getent group | awk -F: '{print $1}' | grep -Ei "$VPN_MATCH" | while IFS= read -r NAME; do
    [ -n "$NAME" ] && groupdel "$NAME" >/dev/null 2>&1 || true
  done

  # Delete the certificate generated for the panel domain.
  if [ -n "$VPN_DOMAIN" ] && [[ "$VPN_DOMAIN" != *'/'* ]]; then
    certbot delete --cert-name "$VPN_DOMAIN" --non-interactive >/dev/null 2>&1 || true
    rm -rf "/etc/letsencrypt/live/$VPN_DOMAIN" "/etc/letsencrypt/archive/$VPN_DOMAIN"
    rm -f "/etc/letsencrypt/renewal/$VPN_DOMAIN.conf"
  fi

  # Delete all SULTAN/VPN systemd leftovers after package removal.
  find /etc/systemd/system /run/systemd/system /usr/local/lib/systemd/system /lib/systemd/system /usr/lib/systemd/system \
    -maxdepth 3 \( -type f -o -type l \) 2>/dev/null |
    grep -Ei "$VPN_MATCH" | while IFS= read -r PKG; do rm -f -- "$PKG" 2>/dev/null || true; done
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl reset-failed >/dev/null 2>&1 || true

  # Remove persistent network tuning added by this and other VPN installers,
  # then restore conservative Linux TCP defaults immediately.
  rm -f /etc/sysctl.d/*sultan* /etc/sysctl.d/*vpn* /etc/sysctl.d/*openvpn* /etc/sysctl.d/*wireguard* /etc/sysctl.d/*xray* /etc/sysctl.d/*hysteria* 2>/dev/null || true
  sed -i -E '/(sultan|vpn|openvpn|wireguard|xray|v2ray|hysteria|badvpn|udpgw|tcp_congestion_control[[:space:]]*=[[:space:]]*bbr|default_qdisc[[:space:]]*=[[:space:]]*fq)/Id' /etc/sysctl.conf 2>/dev/null || true
  if sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw cubic; then
    sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1 || true
  fi
  sysctl -w net.core.default_qdisc=fq_codel >/dev/null 2>&1 || true
  sysctl -w net.core.somaxconn=4096 >/dev/null 2>&1 || true
  sysctl -w net.core.netdev_max_backlog=1000 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_max_syn_backlog=4096 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_fastopen=1 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_mtu_probing=0 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_slow_start_after_idle=1 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_fin_timeout=60 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_notsent_lowat=4294967295 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_keepalive_time=7200 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_keepalive_intvl=75 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.tcp_keepalive_probes=9 >/dev/null 2>&1 || true
  sysctl -w net.ipv4.ip_local_port_range='32768 60999' >/dev/null 2>&1 || true
  sysctl --system >/dev/null 2>&1 || true

  printf 'Finished: %s\n' "$(date -Is 2>/dev/null || date)" >> "$REPORT"
  echo "All detected VPN/tunnel/SULTAN components were removed."
  echo "Removal report: $REPORT"
  echo "Reboot the VPS to unload any remaining kernel state."
}

remove_script(){
  refresh_screen
  read -p "Type YES to remove: " C
  C="$(echo "$C" | tr '[:lower:]' '[:upper:]')"
  [ "$C" = "YES" ] || return

  TMP_USERS="$(mktemp "$BASE/.remove-users.XXXXXX")" || return
  awk -F'|' 'NF{print $1}' /etc/sultan/users.db > "$TMP_USERS" 2>/dev/null || true
  while IFS= read -r U; do
    [ -n "$U" ] || continue
    delete_managed_ssh_user "$U" || echo "Skipped user: $U"
  done < "$TMP_USERS"
  rm -f "$TMP_USERS"

  purge_all_vpn_components

  systemctl disable --now sultan-ws udp-custom sultan-quota.timer sultan-quota.service sultan-xray-stats.timer sultan-xray-stats.service sultan-xray-limit-enforcer.timer sultan-xray-limit-enforcer.service xray 2>/dev/null || true
  rm -f /etc/systemd/system/sultan-ws.service
  rm -f /etc/systemd/system/udp-custom.service
  rm -f /etc/systemd/system/sultan-quota.service
  rm -f /etc/systemd/system/sultan-quota.timer
  rm -f /etc/systemd/system/sultan-xray-stats.service
  rm -f /etc/systemd/system/sultan-xray-stats.timer
  rm -f /etc/systemd/system/sultan-xray-limit-enforcer.service
  rm -f /etc/systemd/system/sultan-xray-limit-enforcer.timer
  rm -f /etc/systemd/system/xray.service /etc/systemd/system/xray@.service
  rm -rf /etc/systemd/system/xray.service.d
  rm -f /usr/local/bin/xray /usr/local/share/xray/geoip.dat /usr/local/share/xray/geosite.dat
  rm -rf /usr/local/etc/xray /usr/local/share/xray
  rm -f /usr/local/bin/sultan-ssh-ws
  rm -f /usr/local/bin/sultan-udp-relay
  rm -f /usr/local/sbin/sultan-login-limit
  rm -f /usr/local/sbin/sultan-quota-sync
  rm -f /usr/local/sbin/sultan-xray-stats-sync
  rm -f /usr/local/sbin/sultan-xray-limit-enforcer
  rm -f /usr/local/sbin/sultan-tunnel-shell
  sed -i '\|/usr/local/sbin/sultan-tunnel-shell|d' /etc/shells 2>/dev/null || true
  rm -f /etc/systemd/system/user-.slice.d/50-sultan-ipaccounting.conf
  sed -i '\|/usr/local/sbin/sultan-login-limit|d' /etc/pam.d/sshd 2>/dev/null || true
  rm -f /etc/ssh/sshd_config.d/98-sultan-legacy-login.conf /etc/ssh/sshd_config.d/99-sultan-users.conf
  rm -f /etc/nginx/conf.d/sultan-ready.conf
  rm -f /etc/letsencrypt/renewal-hooks/deploy/sultan-reload.sh
  rm -f /etc/fail2ban/jail.d/sultan-sshd.conf
  rm -f /etc/sysctl.d/99-sultan-bbr.conf
  rm -f /etc/sysctl.d/98-sultan-online-detection.conf /etc/sysctl.d/97-sultan-fast-network.conf
  sysctl --system >/dev/null 2>&1 || true
  nft delete table inet sultan_quota 2>/dev/null || true
  nft delete table inet sultan_limits 2>/dev/null || true
  ufw --force delete allow 80/tcp >/dev/null 2>&1 || true
  ufw --force delete allow 443/tcp >/dev/null 2>&1 || true
  ufw --force delete allow 7300/udp >/dev/null 2>&1 || true
  if [ -f /etc/haproxy/haproxy.cfg ] && grep -q "SULTAN MANAGED" /etc/haproxy/haproxy.cfg; then
    LATEST_BAK="$(ls -1t /etc/haproxy/haproxy.cfg.sultan.bak.* 2>/dev/null | head -n1 || true)"
    [ -n "$LATEST_BAK" ] && cp -a "$LATEST_BAK" /etc/haproxy/haproxy.cfg
  fi
  rm -rf /etc/sultan
  rm -f /usr/local/bin/menu
  systemctl daemon-reload
  safe_restart_ssh || true
  echo "SULTAN removed"
  exit
}

case "${1:-}" in
  --web-panel-refresh)
    SULTAN_NONINTERACTIVE=1
    web_panel_ensure_path >/dev/null || exit 1
    web_panel_write_server || exit 1
    web_panel_write_service || exit 1
    web_panel_refresh_nginx || exit 1
    web_panel_print_urls
    exit 0
    ;;
  --ready-install)
    SULTAN_NONINTERACTIVE=1
    setup_ready
    exit $?
    ;;
  --health-check)
    SULTAN_NONINTERACTIVE=1
    full_install_self_test "$(get_domain)"
    exit $?
    ;;
esac

main_menu
PANEL

chmod +x "$PANEL"

echo "[5/7] Enabling services..."
systemctl daemon-reload
systemctl enable sultan-quota.timer sultan-xray-stats.timer sultan-xray-limit-enforcer.timer >/dev/null 2>&1 || true
systemctl restart sultan-quota.timer
systemctl restart sultan-xray-stats.timer
systemctl restart sultan-xray-limit-enforcer.timer
systemctl enable ssh 2>/dev/null || systemctl enable sshd 2>/dev/null || true
systemctl enable nginx haproxy vnstat fail2ban 2>/dev/null || true
if sshd -t; then
  if current_session_transport_sensitive; then
    echo "Current SSH session uses a protected transport; SSH reload skipped."
  else
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
  fi
else
  echo "SSH config error. Reload skipped."
fi
systemctl restart vnstat 2>/dev/null || true

CURRENT_SSH_IP="${SSH_CONNECTION%% *}"
case "$CURRENT_SSH_IP" in
  ''|*[!0-9a-fA-F:.]*) CURRENT_SSH_IP="" ;;
esac
mkdir -p /etc/fail2ban/jail.d
cat >/etc/fail2ban/jail.d/sultan-sshd.conf <<EOF
[sshd]
enabled = true
port = ssh
filter = sshd
backend = systemd
maxretry = 5
findtime = 10m
bantime = 1h
ignoreip = 127.0.0.1/8 ::1 $CURRENT_SSH_IP
EOF
if current_session_transport_sensitive; then
  echo "Current SSH session uses a protected transport; Fail2Ban restart skipped to protect this session."
else
  systemctl restart fail2ban 2>/dev/null || {
  echo "Fail2Ban restart failed; installation will continue without closing SSH."
  }
fi
[ -n "$CURRENT_SSH_IP" ] && fail2ban-client set sshd unbanip "$CURRENT_SSH_IP" >/dev/null 2>&1 || true

cat >/etc/sysctl.d/97-sultan-fast-network.conf <<'EOF'
net.core.somaxconn=65535
net.core.netdev_max_backlog=250000
net.ipv4.tcp_max_syn_backlog=65535
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.tcp_fin_timeout=10
net.ipv4.tcp_tw_reuse=1
net.ipv4.ip_local_port_range=1024 65535
net.ipv4.tcp_notsent_lowat=16384
net.ipv4.tcp_keepalive_time=5
net.ipv4.tcp_keepalive_intvl=2
net.ipv4.tcp_keepalive_probes=2
EOF
sysctl -p /etc/sysctl.d/97-sultan-fast-network.conf >/dev/null 2>&1 || true

modprobe tcp_bbr 2>/dev/null || true
cat >/etc/sysctl.d/99-sultan-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
sysctl -p /etc/sysctl.d/99-sultan-bbr.conf >/dev/null 2>&1 || sysctl --system >/dev/null 2>&1 || true

# HAProxy already enables TCP keepalive on public VPN sockets. Use a short,
# conservative keepalive window so a phone that loses Internet is removed from
# the kernel socket table in seconds instead of remaining ESTABLISHED for hours.
cat >/etc/sysctl.d/98-sultan-online-detection.conf <<'EOF'
net.ipv4.tcp_keepalive_time=5
net.ipv4.tcp_keepalive_intvl=2
net.ipv4.tcp_keepalive_probes=2
EOF
sysctl -p /etc/sysctl.d/98-sultan-online-detection.conf >/dev/null 2>&1 || true

/usr/local/sbin/sultan-quota-sync || true
/usr/local/sbin/sultan-xray-stats-sync || true
/usr/local/sbin/sultan-xray-limit-enforcer || true

echo "[Before V2Ray setup] Checking existing VMess/VLESS/Trojan users..."
if ! handle_existing_xray_users_before_ready; then
  echo "Existing V2Ray user delete/restore step failed."
  SULTAN_INSTALL_STATUS=1
fi

echo "[6/7] Ready setup..."
echo "You will be asked for your domain. The installer will continue automatically after setup."
SULTAN_INSTALL_STATUS="${SULTAN_INSTALL_STATUS:-0}"
if [ "$SULTAN_INSTALL_STATUS" -eq 0 ] && ! "$PANEL" --ready-install; then
  echo "Ready setup failed. Fix the error above, then run: menu"
  echo "Xray status:"
  systemctl status xray --no-pager -l 2>/dev/null || true
  journalctl -u xray -n 30 --no-pager 2>/dev/null || true
  SULTAN_INSTALL_STATUS=1
fi

if [ "$SULTAN_INSTALL_STATUS" -eq 0 ]; then
  echo "Ready setup and its built-in WebSocket verification completed."
fi


if [ "$SULTAN_INSTALL_STATUS" -eq 0 ]; then
  echo ""
  echo "[7/7] Installing final mini package..."
  if ! run_install_mini_chained_safely; then
    echo "Final mini installation failed."
    SULTAN_INSTALL_STATUS=1
  else
    echo "Restoring the full Web Panel route after install-mini..."
    if ! "$PANEL" --web-panel-refresh; then
      echo "Web Panel route refresh failed. Run: menu -> 21 -> 5"
      SULTAN_INSTALL_STATUS=1
    fi
  fi
fi

echo ""
echo "==========================================="
if [ "$SULTAN_INSTALL_STATUS" -eq 0 ]; then
  echo "Installation verified. Type: menu"
  echo "Mandatory HTTP 101 / 502 prevention: PASSED"
echo "V2Ray WS 80 support: ENABLED"
else
  echo "Installation verification FAILED."
  echo "Mandatory HTTP 101 / 502 prevention did not pass."
  echo "Fix the reported error, then run: menu -> 10 -> 1"
fi
echo "Max Login 0 = Unlimited"
echo "GB Limit  0 = Unlimited"
echo "Quota check: every 10 seconds"
if [ "$SULTAN_INSTALL_STATUS" -eq 0 ]; then
  WEB_PATH="$(head -n1 /etc/sultan/web-panel.path 2>/dev/null | tr -d '\r[:space:]')"
  WEB_DOMAIN="$(head -n1 "$DOMAIN_FILE" 2>/dev/null | tr -d '\r[:space:]')"
  WEB_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
  if [ -n "$WEB_PATH" ] && systemctl is-active --quiet sultan-web-panel 2>/dev/null; then
    echo "-------------------------------------------"
    echo "WEB PANEL URL"
    [ -n "$WEB_IP" ] && echo "http://$WEB_IP$WEB_PATH"
    [ -n "$WEB_DOMAIN" ] && [ "$WEB_DOMAIN" != "Not Set" ] && echo "https://$WEB_DOMAIN$WEB_PATH"
  else
    echo "Web Panel browser URL: run menu -> 21 -> 1. The URL will stay visible until you press Enter."
  fi
fi
echo "Installation log: $SULTAN_INSTALL_LOG"
echo "==========================================="

if [ "$SULTAN_INSTALL_STATUS" -eq 0 ]; then
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    drain_pending_tty_input
    IFS= read -r -p "Press Enter to open the SULTAN menu..." _finish < /dev/tty || true
    # Enter now opens the panel menu instead of ending the installer process.
    # Choosing Exit from the menu returns normally to the SSH shell.
    exec "$PANEL"
  fi
  echo "Installation complete. Run: menu"
  exit 0
fi

if [ -r /dev/tty ] && [ -w /dev/tty ]; then
  drain_pending_tty_input
  IFS= read -r -p "Installation failed. Press Enter to return to the SSH shell..." _finish < /dev/tty || true
fi
exit 1



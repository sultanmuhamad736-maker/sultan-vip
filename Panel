cat << 'APP_EOF' > /opt/sultan-panel/app.py
import os, subprocess, json
from flask import Flask, render_template, request, jsonify, session, redirect, url_for

app = Flask(__name__)
app.secret_key = "sultan_vip_boss_key"

DB_FILE = "/etc/sultan/users.db"
USAGE_FILE = "/etc/sultan/limits/usage.db"
SELLERS_DIR = "/etc/sultan/sellers/"
ADMIN_FILE = "/etc/sultan/admin.json"

def get_admin_creds():
    if os.path.exists(ADMIN_FILE):
        with open(ADMIN_FILE, "r") as f:
            try: return json.load(f)
            except: pass
    return {"username": "sultan", "password": "1100"}

def format_bytes(b):
    try: b = float(b)
    except: return "0.00 B"
    if b < 1024: return f"{b:.2f} B"
    elif b < 1048576: return f"{b/1024:.2f} KB"
    elif b < 1073741824: return f"{b/1048576:.2f} MB"
    elif b < 1099511627776: return f"{b/1073741824:.2f} GB"
    else: return f"{b/1099511627776:.2f} TB"

def calc_percent(used, quota_str):
    if quota_str in ["Unlimited", "0", ""]: return 0
    try:
        gb = float(quota_str.upper().replace("GB", "").strip())
        total_bytes = gb * 1073741824
        if total_bytes == 0: return 0
        p = (used / total_bytes) * 100
        return min(p, 100)
    except: return 0

def get_domain():
    try:
        if os.path.exists("/etc/sultan/domain"):
            with open("/etc/sultan/domain", "r") as f:
                d = f.read().strip()
                if d and d != "Not Set": return d
    except: pass
    return "s.sultanmuhamad.xyz"

def get_server_stats():
    try:
        cpu = subprocess.getoutput("top -bn1 | grep 'Cpu(s)' | awk '{print $2 + $4}'") + "%"
        ram_total = subprocess.getoutput("free -m | awk '/Mem:/ {print $2}'")
        ram_used = subprocess.getoutput("free -m | awk '/Mem:/ {print $3}'")
        uptime = subprocess.getoutput("uptime -p | sed 's/up //'")
        return {"cpu": cpu, "ram": f"{ram_used}MB / {ram_total}MB", "uptime": uptime}
    except: return {"cpu": "N/A", "ram": "N/A", "uptime": "N/A"}

def get_sellers_map():
    seller_map = {}
    if os.path.exists(SELLERS_DIR):
        for filename in os.listdir(SELLERS_DIR):
            if filename.endswith("_users.txt"):
                seller_name = filename.replace("_users.txt", "")
                with open(os.path.join(SELLERS_DIR, filename), "r") as f:
                    for line in f:
                        if line.strip(): seller_map[line.strip()] = seller_name
    return seller_map

def get_users_data():
    users = []
    usage_dict = {}
    shells = {}
    seller_map = get_sellers_map()
    try:
        with open("/etc/passwd", "r") as f:
            for line in f:
                p = line.strip().split(':')
                if len(p) >= 7: shells[p[0]] = p[6]
    except: pass

    if os.path.exists(USAGE_FILE):
        with open(USAGE_FILE, "r") as f:
            for line in f:
                parts = line.strip().split('|')
                if len(parts) >= 2:
                    try: usage_dict[parts[0]] = int(parts[1])
                    except: pass
    total_traffic, total_online = 0, 0
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            for line in f:
                if line.strip():
                    parts = line.strip().split('|')
                    if len(parts) >= 5:
                        user = parts[0]
                        used_bytes = usage_dict.get(user, 0)
                        total_traffic += used_bytes
                        online_count = 0
                        slot_dir = f"/run/sultan-login-slots/{user}"
                        if os.path.isdir(slot_dir): online_count = len([n for n in os.listdir(slot_dir) if os.path.isfile(os.path.join(slot_dir, n))])
                        total_online += online_count
                        creator = seller_map.get(user, "Admin")
                        user_shell = shells.get(user, "/bin/bash")
                        status = "Stopped" if user_shell == "/bin/false" else "Active"
                        users.append({
                            "user": user, "pass": parts[1], "exp": parts[2],
                            "quota": parts[3], "logins": parts[4],
                            "used_bytes": used_bytes, "used_formatted": format_bytes(used_bytes),
                            "percent": calc_percent(used_bytes, parts[3]), "online": online_count,
                            "creator": creator, "status": status
                        })
    return users, format_bytes(total_traffic), total_online

def reset_user_usage(username):
    uid = subprocess.getoutput(f"id -u {username}").strip()
    if uid.isdigit():
        os.system(f"systemctl set-property --runtime user-{uid}.slice IPAccounting=no 2>/dev/null")
        os.system(f"systemctl stop user-{uid}.slice 2>/dev/null")
        os.system(f"systemctl reset-failed user-{uid}.slice 2>/dev/null")
        os.system(f"nft delete counter inet sultan_quota u_{uid}_out 2>/dev/null")
    lines = []
    if os.path.exists(USAGE_FILE):
        with open(USAGE_FILE, "r") as f: lines = [l for l in f if not l.startswith(f"{username}|")]
    with open(USAGE_FILE, "w") as f: f.writelines(lines)

def delete_user_records(username):
    for db in [USAGE_FILE, "/etc/sultan/limits/blocked.db", "/etc/sultan/limits/quota-locked.db"]:
        if os.path.exists(db):
            with open(db, "r") as f: clean_lines = [l for l in f if not l.startswith(f"{username}|") and l.strip() != username]
            with open(db, "w") as f: f.writelines(clean_lines)

@app.before_request
def require_login():

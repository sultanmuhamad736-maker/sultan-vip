    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

@app.route('/add', methods=['POST'])
def add_user():
    if not session.get('logged_in'): return jsonify({"error": "Unauthorized"}), 401
    data = request.json
    user = data.get('user')
    password = data.get('password')
    days = data.get('days', '30')
    quota = data.get('quota', '0')
    logins = data.get('logins', '1')

    if not user or not password: return jsonify({"status": "error", "msg": "أدخل البيانات"}), 400
    if os.path.exists(DB_FILE) and user in subprocess.getoutput(f"cat {DB_FILE}"): return jsonify({"status": "error", "msg": "موجود مسبقا!"}), 400

    os.system(f"useradd -m -s /bin/bash {user}")
    os.system(f"echo '{user}:{password}' | chpasswd")
    
    exp_date = "Unlimited"
    if str(days) != "0":
        exp_date = subprocess.getoutput(f"date -d '+{days} days' +%Y-%m-%d")
        os.system(f"chage -E {exp_date} {user}")
    else: os.system(f"chage -E -1 {user}")

    quota_text = "Unlimited" if str(quota) == "0" else f"{quota}GB"
    login_text = "Unlimited" if str(logins) == "0" else str(logins)

    with open(DB_FILE, "a") as f: f.write(f"{user}|{password}|{exp_date}|{quota_text}|{login_text}\n")
    
    reset_user_usage(user)
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

@app.route('/delete', methods=['POST'])
def delete_user():
    if not session.get('logged_in'): return jsonify({"error": "Unauthorized"}), 401
    user = request.json.get('user')
    os.system(f"pkill -KILL -u {user}")
    os.system(f"userdel -r {user}")
    
    users_list = []
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            for line in f:
                if line.strip() and not line.startswith(f"{user}|"): users_list.append(line.strip())
    with open(DB_FILE, "w") as f:
        for u in users_list: f.write(f"{u}\n")
            
    delete_user_records(user)
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

@app.route('/toggle', methods=['POST'])
def toggle_user():
    if not session.get('logged_in'): return jsonify({"error": "Unauthorized"}), 401
    user = request.json.get('user')
    action = request.json.get('action')
    if action == 'stop':
        os.system(f"usermod -s /bin/false {user}")
        os.system(f"pkill -KILL -u {user}")
    else: os.system(f"usermod -s /bin/bash {user}")
    return jsonify({"status": "success"})

@app.route('/edit', methods=['POST'])
def edit_user():
    if not session.get('logged_in'): return jsonify({"error": "Unauthorized"}), 401
    data = request.json
    target_user = data.get('user')
    new_pass = data.get('password')
    new_days = data.get('days')
    new_quota = data.get('quota')
    new_logins = data.get('logins')
    
    users_list = []
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            for line in f:
                if line.strip():
                    parts = line.strip().split('|')
                    if len(parts) >= 5:
                        if parts[0] == target_user:
                            if new_pass:
                                parts[1] = new_pass
                                os.system(f"echo '{target_user}:{new_pass}' | chpasswd")
                            if new_days and new_days.strip() != "":
                                if new_days == "0":
                                    parts[2] = "Unlimited"
                                    os.system(f"chage -E -1 {target_user}")
                                else:
                                    exp_date = subprocess.getoutput(f"date -d '+{new_days} days' +%Y-%m-%d")
                                    parts[2] = exp_date
                                    os.system(f"chage -E {exp_date} {target_user}")
                            if new_quota and new_quota.strip() != "":
                                parts[3] = "Unlimited" if new_quota == "0" else f"{new_quota}GB"
                            if new_logins and new_logins.strip() != "":
                                parts[4] = "Unlimited" if new_logins == "0" else str(new_logins)
                        users_list.append(parts)
    with open(DB_FILE, "w") as f:
        for u in users_list: f.write("|".join(u) + "\n")
            
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})


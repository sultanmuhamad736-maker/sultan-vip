                    let bar = document.getElementById('bar_usage_' + u.user); 
                    let onlineSpan = document.getElementById('online_status_' + u.user);
                    if(txt) txt.innerText = u.used_formatted + ' / ' + u.quota;
                    if(bar) bar.style.width = u.percent + '%';
                    if(onlineSpan) {
                        if(u.online > 0) { onlineSpan.innerHTML = '🟢 Online: ' + u.online + ' / ' + u.logins; onlineSpan.style.color = '#34d399'; }
                        else { onlineSpan.innerHTML = '⚪ Online: ' + u.online + ' / ' + u.logins; onlineSpan.style.color = '#94a3b8'; }
                    }
                });
            } catch(e) {}
        }
        
        // واجهة البانل تتحدث كل ثانية واحدة بدون إزعاج 
        setInterval(updateDataSilently, 1000);

        async function forceSync(btn) { btn.innerText = "جاري المسح..."; await fetch('/force_sync', { method: 'POST' }); btn.innerText = "🔄 مسح المتجاوزين"; }
        function showInfoModal(user, pass, exp, quota, logins) { activeUserInfo = { user, pass }; document.getElementById('infoContent').innerText = "Username : " + user + "\nPassword : " + pass + "\nExpire   : " + exp + "\nQuota    : " + quota + "\nUsed     : ...\nMax Login: " + logins + "\nOnline   : ..."; document.getElementById('infoModal').style.display = 'flex'; }
        function copyInfoBox() { const el = document.createElement('textarea'); el.value = document.getElementById('infoContent').innerText; document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el); }
        
        function copyConfig(user, pass) {
            const text = "User : " + user + "\n\nPassword : " + pass + "\n\nSNI : " + DOMAIN + "\n\nPayload :\n\nGET /cdn-cgi/trace HTTP/1.1[crlf]Host:  172.65.90.47[crlf][crlf]CF-RAY / HTTP/1.1[crlf]Host:  " + DOMAIN + "[crlf]Upgrade:  Websocket[crlf]Connection:  Keep-Alive[crlf]User-Agent:  [ua][crlf]Upgrade:  websocket[crlf][crlf]\n\nSNI social :\n www.twitter.com\n or \nwww.snapchat.com\n\nPayload social :\n\nGET / HTTP/1.1[crlf]Host: www.snapchat.com[crlf]Upgrade: websocket[crlf][crlf]\n\nOr\n\nGET / HTTP/1.1[crlf]Host: www.twitter.com[crlf]Upgrade: websocket[crlf][crlf]";
            const el = document.createElement('textarea'); el.value = text; document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el);
        }

        // دالة NPV الدقيقة والمضبوطة (Host + Payload + Default TLS)
        function copyNpv(user, pass) {
            const config = {
                "sshConfigType": "SSH-TLS-Payload",
                "remarks": "Sultan VIP - " + user,
                "sshHost": "172.65.90.47",
                "sshPort": 443,
                "sshUsername": user,
                "sshPassword": pass,
                "sshAuthMethod": "Password",
                "sshPrivateKey": "",
                "sshPrivateKeyPassphrase": "",
                "sni": DOMAIN,
                "tlsVersion": "DEFAULT",
                "httpProxy": "",
                "authenticateProxy": false,
                "proxyUsername": "",
                "proxyPassword": "",
                "payload": "GET /cdn-cgi/trace HTTP/1.1[crlf]Host:  172.65.90.47[crlf][crlf]CF-RAY / HTTP/1.1[crlf]Host:  " + DOMAIN + "[crlf]Upgrade:  Websocket[crlf]Connection:  Keep-Alive[crlf]User-Agent:  [ua][crlf]Upgrade:  websocket[crlf][crlf]",
                "dnsTTMode": "UDP",
                "dnsServer": "",
                "nameserver": "",
                "publicKey": "",
                "udpgwPort": 7300,
                "udpgwTransparentDNS": true
            };
            const jsonStr = JSON.stringify(config);
            const base64Str = btoa(unescape(encodeURIComponent(jsonStr)));
            const npvLink = "npvt-ssh://" + base64Str;
            const el = document.createElement('textarea');
            el.value = npvLink;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
        }

        function showStatsModal() { document.getElementById('statsModal').style.display = 'flex'; }
        function showAddModal() { document.getElementById('addModal').style.display = 'flex'; }
        function showEditModal(user) { document.getElementById('edit_user').value = user; document.getElementById('edit_pass').value = ''; document.getElementById('edit_days').value = ''; document.getElementById('edit_quota').value = ''; document.getElementById('edit_logins').value = ''; document.getElementById('editModal').style.display = 'flex'; }
        function closeModals() { document.querySelectorAll('.modal').forEach(m => m.style.display = 'none'); activeUserInfo = {}; }

        // عمليات الحفظ والتعديل بصمت وسرعة
        async function saveNewUser(btn) {
            if (btn.disabled) return;
            const user = document.getElementById('add_user').value, pass = document.getElementById('add_pass').value, days = document.getElementById('add_days').value, quota = document.getElementById('add_quota').value, logins = document.getElementById('add_logins').value;
            if(!user || !pass) return;
            btn.disabled = true; btn.innerText = "جاري الحفظ...";
            try { 
                await fetch('/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user, password: pass, days, quota, logins }) }); 
                smoothReload(); 
            } catch(e) { smoothReload(); }
        }
        
        async function deleteUser(user) {
            await fetch('/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user }) }); 
            smoothReload();
        }
        
        async function saveEditUser(btn) {
            if (btn.disabled) return;
            const user = document.getElementById('edit_user').value, pass = document.getElementById('edit_pass').value, days = document.getElementById('edit_days').value, quota = document.getElementById('edit_quota').value, logins = document.getElementById('edit_logins').value;
            btn.disabled = true; btn.innerText = "جاري الحفظ...";
            try { 
                await fetch('/edit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user, password: pass, days, quota, logins }) }); 
                smoothReload(); 
            } catch(e) { smoothReload(); }
        }
        
        async function toggleUser(user, action) {
            await fetch('/toggle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user: user, action: action }) }); 
            smoothReload();
        }
    </script>

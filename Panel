import os, subprocess, json
from flask import Flask, render_template, request, jsonify

app = Flask(__name__)
DB_FILE = "/etc/sultan/users.db"
USAGE_FILE = "/etc/sultan/limits/usage.db"

def format_bytes(b):
    try: b = float(b)
    except: return "0.00 B"
    if b < 1024: return f"{b:.2f} B"
    elif b < 1048576: return f"{b/1024:.2f} KB"
    elif b < 1073741824: return f"{b/1048576:.2f} MB"
    elif b < 1099511627776: return f"{b/1073741824:.2f} GB"
    else: return f"{b/1099511627776:.2f} TB"

def calc_percent(used, quota_str):
    if quota_str in ["Unlimited", "0", ""]: return 0
    try:
        gb = float(quota_str.upper().replace("GB", "").strip())
        total_bytes = gb * 1024 * 1024 * 1024
        if total_bytes == 0: return 0
        return min((used / total_bytes) * 100, 100)
    except: return 0

def get_domain():
    try:
        if os.path.exists("/etc/sultan/domain"):
            with open("/etc/sultan/domain", "r") as f:
                d = f.read().strip()
                if d and d != "Not Set": return d
    except: pass
    return "s.sultanmuhamad.xyz"

def get_server_stats():
    try:
        cpu = subprocess.getoutput("top -bn1 | grep 'Cpu(s)' | awk '{print $2 + $4}'") + "%"
        ram_total = subprocess.getoutput("free -m | awk '/Mem:/ {print $2}'")
        ram_used = subprocess.getoutput("free -m | awk '/Mem:/ {print $3}'")
        uptime = subprocess.getoutput("uptime -p | sed 's/up //'")
        return {"cpu": cpu, "ram": f"{ram_used}MB / {ram_total}MB", "uptime": uptime}
    except: return {"cpu": "N/A", "ram": "N/A", "uptime": "N/A"}

def get_users_data():
    users = []
    usage_dict = {}
    if os.path.exists(USAGE_FILE):
        with open(USAGE_FILE, "r") as f:
            for line in f:
                parts = line.strip().split('|')
                if len(parts) >= 2:
                    try: usage_dict[parts[0]] = int(parts[1])
                    except: pass
    total_traffic, total_online = 0, 0
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            for line in f:
                if line.strip():
                    parts = line.strip().split('|')
                    if len(parts) >= 5:
                        user = parts[0]
                        used_bytes = usage_dict.get(user, 0)
                        total_traffic += used_bytes
                        online_count = 0
                        slot_dir = f"/run/sultan-login-slots/{user}"
                        if os.path.isdir(slot_dir): online_count = len([n for n in os.listdir(slot_dir) if os.path.isfile(os.path.join(slot_dir, n))])
                        total_online += online_count
                        users.append({
                            "user": user, "pass": parts[1], "exp": parts[2],
                            "quota": parts[3], "logins": parts[4],
                            "used_bytes": used_bytes, "used_formatted": format_bytes(used_bytes),
                            "percent": calc_percent(used_bytes, parts[3]), "online": online_count
                        })
    return users, format_bytes(total_traffic), total_online

@app.route('/')
def index():
    users, total_traffic, total_online = get_users_data()
    return render_template('index.html', users=users, domain=get_domain(), total_users=len(users), total_traffic=total_traffic, total_online=total_online, server_stats=get_server_stats())

@app.route('/api/data')
def api_data():
    users, total_traffic, total_online = get_users_data()
    return jsonify({"users": users, "total_traffic": total_traffic, "total_online": total_online, "server_stats": get_server_stats()})

@app.route('/force_sync', methods=['POST'])
def force_sync():
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

@app.route('/add', methods=['POST'])
def add_user():
    data = request.json
    user, password, days, quota, logins = data.get('user'), data.get('password'), data.get('days', '30'), data.get('quota', '0'), data.get('logins', '1')
    try: float(quota)
    except: return jsonify({"status": "error", "msg": "كمية الجيجات غير صالحة"}), 400
    os.system(f"useradd -m -s /bin/bash {user}; echo '{user}:{password}' | chpasswd")
    exp_date = "Unlimited"
    if str(days) != "0":
        exp_date = subprocess.getoutput(f"date -d '+{days} days' +%Y-%m-%d")
        os.system(f"chage -E {exp_date} {user}")
    else: os.system(f"chage -E -1 {user}")
    quota_text = "Unlimited" if float(quota) <= 0 else f"{quota}GB"
    login_text = "Unlimited" if str(logins) == "0" else str(logins)
    with open(DB_FILE, "a") as f: f.write(f"{user}|{password}|{exp_date}|{quota_text}|{login_text}\n")
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

@app.route('/delete', methods=['POST'])
def delete_user():
    user = request.json.get('user')
    os.system(f"pkill -KILL -u {user}; userdel -r {user}")
    users_list = [l.strip() for l in open(DB_FILE) if l.strip() and not l.startswith(f"{user}|")]
    with open(DB_FILE, "w") as f: f.write("\n".join(users_list) + "\n")
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

@app.route('/edit', methods=['POST'])
def edit_user():
    data = request.json
    target_user, new_pass, new_days, new_quota, new_logins = data.get('user'), data.get('password'), data.get('days'), data.get('quota'), data.get('logins')
    users_list = []
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            for line in f:
                parts = line.strip().split('|')
                if len(parts) >= 5 and parts[0] == target_user:
                    if new_pass:
                        parts[1] = new_pass; os.system(f"echo '{target_user}:{new_pass}' | chpasswd")
                    if new_days and new_days.strip() != "":
                        try:
                            nd = int(new_days)
                            if nd == 0: parts[2] = "Unlimited"; os.system(f"chage -E -1 {target_user}")
                            else:
                                base = parts[2] if parts[2] not in ["Unlimited", "0", ""] else subprocess.getoutput("date +%Y-%m-%d")
                                sign = "-" if nd < 0 else "+"
                                exp_date = subprocess.getoutput(f"date -d '{base} {sign} {abs(nd)} days' +%Y-%m-%d")
                                parts[2] = exp_date; os.system(f"chage -E {exp_date} {target_user}")
                        except: pass
                    if new_quota and new_quota.strip() != "":
                        try:
                            add_q = float(new_quota)
                            old_q_str = parts[3].upper().replace("GB","").strip()
                            old_q = float(old_q_str) if old_q_str not in ["UNLIMITED", "0", ""] else 0.0
                            new_q = old_q + add_q
                            parts[3] = "Unlimited" if new_q <= 0 else f"{new_q:.3f}GB"
                        except: pass
                    if new_logins and new_logins.strip() != "":
                        try:
                            nl = int(new_logins)
                            parts[4] = "Unlimited" if nl == 0 else str(nl)
                        except: pass
                if line.strip(): users_list.append(parts)
    with open(DB_FILE, "w") as f:
        for u in users_list: f.write("|".join(u) + "\n")
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

if __name__ == '__main__': app.run(host='0.0.0.0', port=5000)
APP_EOF


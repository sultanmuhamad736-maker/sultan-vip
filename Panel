        body { background-color: #0f111a; color: #fff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; padding-bottom: 80px;}
        .header { display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px solid #1f2233; }
        .logo { color: #fbbf24; font-size: 22px; font-weight: bold; text-transform: uppercase; }
        .content { padding: 20px; }
        .stats-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap:10px;}
        .stats-header h2 { margin: 0; font-size: 20px; }
        .btn-add { background-color: #34d399; color: #000; padding: 10px 20px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 5px; }
        .btn-force { background-color: #f87171; color: #fff; }
        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-bottom: 30px; }
        .stat-card { background-color: #1a1d2d; padding: 20px; border-radius: 12px; }
        .stat-card .label { color: #94a3b8; font-size: 12px; margin-bottom: 10px; text-transform: uppercase; }
        .stat-card .value { font-size: 24px; font-weight: bold; }
        .value.cyan { color: #34d399; }
        .value.yellow { color: #fbbf24; }
        .user-card { background-color: #1a1d2d; padding: 15px; border-radius: 12px; margin-bottom: 15px; }
        .user-top { display: flex; justify-content: space-between; margin-bottom: 15px; }
        .user-title { display: flex; gap: 15px; align-items: center; }
        .badge-ssh { background-color: #334155; padding: 5px 12px; border-radius: 20px; font-size: 12px; }
        .username { font-size: 18px; font-weight: bold; }
        .traffic-info { text-align: right; font-size: 12px; color: #cbd5e1; width: 40%;}
        .progress-bg { width: 100%; height: 4px; background: #334155; margin-top:5px; border-radius:3px; position:relative; overflow:hidden;}
        .progress-bar { height: 100%; background: #34d399; border-radius:3px; transition: width 0.5s ease;}
        .details-row { display: flex; justify-content: space-between; color: #94a3b8; font-size: 14px; margin-bottom: 15px; border-bottom: 1px solid #334155; padding-bottom: 15px; align-items: center;}
        .actions { display: flex; gap: 10px; justify-content: flex-start; flex-wrap: wrap;}
        .btn { padding: 6px 12px; border-radius: 6px; font-size: 14px; cursor: pointer; background: transparent; display: flex; align-items: center; gap: 5px;}
        .btn-info { border: 1px solid #38bdf8; color: #38bdf8; }
        .btn-copy { border: 1px solid #34d399; color: #34d399; }
        .btn-edit { border: 1px solid #fbbf24; color: #fbbf24; }
        .btn-del { border: 1px solid #f87171; color: #f87171; }
        .floating-btn { position: fixed; bottom: 20px; right: 20px; background-color: #fbbf24; color: #000; padding: 12px 20px; border: none; border-radius: 50px; font-weight: bold; font-size: 16px; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.3); z-index: 1000; display: flex; align-items: center; gap: 8px; }
        .floating-btn:hover { background-color: #f59e0b; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); align-items: center; justify-content: center; z-index: 2000;}
        .modal-content { background: #1a1d2d; padding: 25px; border-radius: 12px; width: 90%; max-width: 400px; max-height: 90vh; overflow-y: auto;}
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .modal-header h3 { margin: 0; color: #fff;}
        .close-btn { font-size: 26px; cursor: pointer; color: #94a3b8; line-height: 1; }
        .close-btn:hover { color: #f87171; }
        .input-group { margin-bottom: 15px; }
        .input-group label { display: block; font-size: 12px; color: #94a3b8; margin-bottom: 5px; }
        .input-group input { width: 100%; background: #0f111a; border: 1px solid #334155; color: white; padding: 10px; border-radius: 6px; box-sizing: border-box;}
        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
        .btn-cancel { background: transparent; color: white; border: none; cursor: pointer; }
        .btn-save { background: #34d399; color: black; border: none; padding: 8px 16px; border-radius: 6px; font-weight: bold; cursor: pointer;}
        .info-box { background: #0f111a; padding: 15px; border-radius: 8px; font-family: monospace; white-space: pre-wrap; user-select: all; color: #cbd5e1; border: 1px solid #334155; font-size: 14px;}
        .stats-list .stat-item { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #334155; color: #cbd5e1;}
        .stats-list .stat-item:last-child { border-bottom: none; }
        .stat-item span:last-child { font-weight: bold; color: #fbbf24;}
    </style>
</head>
<body>
    <div class="header"><div class="logo">SULTAN VIP</div></div>
    <div class="content">
        <div class="stats-header">
            <h2>Users & Statistics</h2>
            <div style="display:flex; gap:10px;">
                <button class="btn-add btn-force" onclick="forceSync(this)">🔄 مسح المتجاوزين</button>
                <button class="btn-add" onclick="showAddModal()">+ Add User</button>
            </div>
        </div>
        <div class="stats-grid">
            <div class="stat-card"><div class="label">Accounts</div><div class="value">{{ total_users }}</div></div>
            <div class="stat-card"><div class="label">Traffic</div><div class="value cyan" id="top_traffic">{{ total_traffic }}</div></div>
            <div class="stat-card"><div class="label">Online (متصلين)</div><div class="value yellow" id="top_online">{{ total_online }}</div></div>
        </div>
        {% for u in users %}
        <div class="user-card">
            <div class="user-top">
                <div class="user-title"><span class="badge-ssh">SSH</span><span class="username">{{ u.user }}</span></div>
                <div class="traffic-info">
                    <span id="text_usage_{{ u.user }}">{{ u.used_formatted }} / {{ u.quota }}</span><br>
                    <div class="progress-bg"><div class="progress-bar" id="bar_usage_{{ u.user }}" style="width: {{ u.percent }}%;"></div></div>
                </div>
            </div>
            <div class="details-row">
                <span>Exp: {{ u.exp }}</span>
                <span id="online_status_{{ u.user }}" style="font-weight:bold; color: {% if u.online > 0 %}#34d399{% else %}#94a3b8{% endif %};">
                    {% if u.online > 0 %}🟢{% else %}⚪{% endif %} Online: {{ u.online }} / {{ u.logins }}
                </span>
            </div>
            <div class="actions">
                <button class="btn btn-info" onclick="showInfoModal('{{ u.user }}', '{{ u.pass }}', '{{ u.exp }}', '{{ u.quota }}', '{{ u.logins }}')">ℹ Info</button>
                <button class="btn btn-copy" onclick="copyConfig('{{ u.user }}', '{{ u.pass }}')">📋 Copy</button>
                <button class="btn btn-edit" onclick="showEditModal('{{ u.user }}')">✏ Edit</button>
                <button class="btn btn-del" onclick="deleteUser('{{ u.user }}')">- Del</button>
            </div>
        </div>
        {% endfor %}
    </div>
    <button class="floating-btn" onclick="showStatsModal()">📊 الإحصائيات</button>
    
    <div id="infoModal" class="modal"><div class="modal-content"><div class="modal-header"><h3>User Information</h3><span class="close-btn" onclick="closeModals()">&times;</span></div><div id="infoContent" class="info-box"></div><div class="modal-actions"><button class="btn btn-copy" onclick="copyInfoBox()">📋 Copy Text</button></div></div></div>
    <div id="statsModal" class="modal"><div class="modal-content"><div class="modal-header"><h3>Server Statistics</h3><span class="close-btn" onclick="closeModals()">&times;</span></div><div class="stats-list"><div class="stat-item"><span>CPU Usage:</span> <span id="st_cpu">{{ server_stats.cpu }}</span></div><div class="stat-item"><span>RAM Usage:</span> <span id="st_ram">{{ server_stats.ram }}</span></div><div class="stat-item"><span>Uptime:</span> <span id="st_uptime">{{ server_stats.uptime }}</span></div><div class="stat-item"><span>Total Traffic:</span> <span id="st_traffic">{{ total_traffic }}</span></div><div class="stat-item"><span>Total Online Users:</span> <span id="st_online">{{ total_online }}</span></div></div></div></div>
    
    <div id="addModal" class="modal"><div class="modal-content"><div class="modal-header"><h3>Add New User (SSH)</h3><span class="close-btn" onclick="closeModals()">&times;</span></div><div class="input-group"><label>Username</label><input type="text" id="add_user"></div><div class="input-group"><label>Password</label><input type="text" id="add_pass"></div><div style="display:flex; gap:10px;"><div class="input-group" style="flex:1;"><label>Days</label><input type="number" id="add_days" value="30"></div><div class="input-group" style="flex:1;"><label>Quota (GB)</label><input type="number" step="any" id="add_quota" value="0"></div></div><div class="input-group"><label>Max Logins (0=Unlimit)</label><input type="number" id="add_logins" value="1"></div><div class="modal-actions"><button class="btn-cancel" onclick="closeModals()">Cancel</button><button class="btn-save" onclick="saveNewUser()">Save</button></div></div></div>
    <div id="editModal" class="modal"><div class="modal-content"><div class="modal-header"><h3>Edit User</h3><span class="close-btn" onclick="closeModals()">&times;</span></div><div class="input-group"><label>Username</label><input type="text" id="edit_user" disabled></div><div class="input-group"><label>New Password</label><input type="text" id="edit_pass" placeholder="Leave empty to keep"></div><div style="display:flex; gap:10px;"><div class="input-group" style="flex:1;"><label>Add/Deduct Days</label><input type="number" id="edit_days" placeholder="e.g. 5 or -5"></div><div class="input-group" style="flex:1;"><label>Add/Deduct GB</label><input type="number" step="any" id="edit_quota" placeholder="e.g. 1.001 or -0.5"></div></div><div class="input-group"><label>Max Logins</label><input type="number" id="edit_logins" placeholder="Leave empty to keep"></div><div class="modal-actions"><button class="btn-cancel" onclick="closeModals()">Cancel</button><button class="btn-save" onclick="saveEditUser()">Save Changes</button></div></div></div>

    <script>
        const DOMAIN = "{{ domain }}";
        let activeUserInfo = {};
        setInterval(async () => {
            try {
                const res = await fetch('/api/data'); const data = await res.json();
                document.getElementById('top_traffic').innerText = data.total_traffic; document.getElementById('top_online').innerText = data.total_online;
                const st_cpu = document.getElementById('st_cpu');
                if (st_cpu) { st_cpu.innerText = data.server_stats.cpu; document.getElementById('st_ram').innerText = data.server_stats.ram; document.getElementById('st_uptime').innerText = data.server_stats.uptime; document.getElementById('st_traffic').innerText = data.total_traffic; document.getElementById('st_online').innerText = data.total_online; }
                data.users.forEach(u => {
                    const txt = document.getElementById('text_usage_' + u.user); const bar = document.getElementById('bar_usage_' + u.user); const onlineSpan = document.getElementById('online_status_' + u.user);
                    if(txt) txt.innerText = u.used_formatted + ' / ' + u.quota;
                    if(bar) bar.style.width = u.percent + '%';
                    if(onlineSpan) {
                        if(u.online > 0) { onlineSpan.innerHTML = '🟢 Online: ' + u.online + ' / ' + u.logins; onlineSpan.style.color = '#34d399'; }
                        else { onlineSpan.innerHTML = '⚪ Online: ' + u.online + ' / ' + u.logins; onlineSpan.style.color = '#94a3b8'; }
                    }
                    if (document.getElementById('infoModal').style.display === 'flex' && activeUserInfo.user === u.user) { document.getElementById('infoContent').innerText = "Username : " + u.user + "\nPassword : " + activeUserInfo.pass + "\nExpire   : " + u.exp + "\nQuota    : " + u.quota + "\nUsed     : " + u.used_formatted + "\nMax Login: " + u.logins + "\nOnline   : " + u.online; }
                });
            } catch(e) {}
        }, 3000);

        async function forceSync(btn) { btn.innerText = "جاري المسح..."; await fetch('/force_sync', { method: 'POST' }); btn.innerText = "🔄 مسح المتجاوزين"; }
        function showInfoModal(user, pass, exp, quota, logins) { activeUserInfo = {user, pass}; document.getElementById('infoContent').innerText = "Username : " + user + "\nPassword : " + pass + "\nExpire   : " + exp + "\nQuota    : " + quota + "\nUsed     : ...\nMax Login: " + logins + "\nOnline   : ..."; document.getElementById('infoModal').style.display = 'flex'; }
        function copyInfoBox() { const el = document.createElement('textarea'); el.value = document.getElementById('infoContent').innerText; document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el); alert("تم النسخ!"); }
        function copyConfig(user, pass) {
            const text = "User : " + user + "\n\nPassword : " + pass + "\n\nSNI : " + DOMAIN + "\n\nPayload :\n\nGET /cdn-cgi/trace HTTP/1.1[crlf]Host:  172.65.90.47[crlf][crlf]CF-RAY / HTTP/1.1[crlf]Host:  " + DOMAIN + "[crlf]Upgrade:  Websocket[crlf]Connection:  Keep-Alive[crlf]User-Agent:  [ua][crlf]Upgrade:  websocket[crlf][crlf]\n\nSNI social :\n www.twitter.com\n or \nwww.snapchat.com\n\nPayload social :\n\nGET / HTTP/1.1[crlf]Host: www.snapchat.com[crlf]Upgrade: websocket[crlf][crlf]\n\nOr\n\nGET / HTTP/1.1[crlf]Host: www.twitter.com[crlf]Upgrade: websocket[crlf][crlf]";
            const el = document.createElement('textarea'); el.value = text; document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el); alert("تم النسخ!");
        }
        function showAddModal() { document.getElementById('addModal').style.display = 'flex'; }
        function showEditModal(u) { document.getElementById('edit_user').value = u; document.getElementById('edit_pass').value = ''; document.getElementById('edit_days').value = ''; document.getElementById('edit_quota').value = ''; document.getElementById('edit_logins').value = ''; document.getElementById('editModal').style.display = 'flex'; }
        function closeModals() { document.querySelectorAll('.modal').forEach(m => m.style.display = 'none'); activeUserInfo = {}; }

        async function saveNewUser() {
            const user = document.getElementById('add_user').value, pass = document.getElementById('add_pass').value, days = document.getElementById('add_days').value, quota = document.getElementById('add_quota').value, logins = document.getElementById('add_logins').value;
            if(!user || !pass) return alert("الرجاء إدخال اسم المستخدم وكلمة المرور");
            try { let res = await fetch('/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user, password: pass, days, quota, logins }) }); let r = await res.json(); if(r.status == "error") alert(r.msg); else window.location.reload(); } catch(e) { alert("خطأ في الاتصال"); }
        }
        async function deleteUser(user) {
            if(!confirm("حذف " + user + "؟")) return;
            await fetch('/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user }) }); window.location.reload();
        }
        async function saveEditUser() {
            const user = document.getElementById('edit_user').value, pass = document.getElementById('edit_pass').value, days = document.getElementById('edit_days').value, quota = document.getElementById('edit_quota').value, logins = document.getElementById('edit_logins').value;
            await fetch('/edit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user, password: pass, days, quota, logins }) }); window.location.reload();
        }
    </script>
</body>
</html>
HTML_EOF
cat << 'SYS_EOF' > /etc/systemd/system/sultan-panel.service
[Unit]
Description=Sultan VIP Web Panel
After=network.target
[Service]
User=root
WorkingDirectory=/opt/sultan-panel
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
SYS_EOF
systemctl daemon-reload; systemctl restart sultan-panel 2>/dev/null

# ========================================================
# 4. إعداد أدوات البائعين ونظام الموزعين الذكي (Resellers)
# ========================================================
cat << 'SULTAN_CMD' > /usr/local/bin/sultan
#!/bin/bash
mkdir -p /etc/sultan/sellers; mkdir -p /opt/sultan-sellers
IP=$(curl -s ipv4.icanhazip.com)
show_menu() {
    clear
    echo "========================================"
    echo "      👑 SULTAN SELLERS MANAGER 👑      "
    echo "========================================"
    echo "1. صناعة بائع جديد (Create New Seller)"
    echo "2. تعديل الجيجات والأيام (Edit Quota/Days)"
    echo "3. إدارة البائعين (رابط/يوزر/باسورد)"
    echo "4. حذف بائع (Delete Seller)"
    echo "0. خروج (Exit)"
    echo "========================================"
    read -p "اختر (Select): " opt
    case "$opt" in
        1) create_seller ;;
        2) edit_seller_quota ;;
        3) manage_sellers ;;
        4) delete_seller ;;
        0) exit 0 ;;
        *) echo "خيار غير صحيح!"; sleep 2; show_menu ;;
    esac
}
get_sellers_array() {
    sellers=()
    for file in /etc/sultan/sellers/*.conf; do
        [ -e "$file" ] || continue
        sellers+=("$(basename "$file" .conf)")
    done
}
create_seller() {
    clear
    echo "--- صناعة بائع جديد ---"
    read -p "اسم البائع (Username): " s_user
    if [[ -z "$s_user" || "$s_user" =~ [^a-zA-Z0-9_-] ]]; then echo "❌ اسم البائع غير صالح."; sleep 2; show_menu; return; fi
    if [ -f "/etc/sultan/sellers/$s_user.conf" ]; then echo "❌ البائع موجود مسبقاً!"; sleep 2; show_menu; return; fi
    read -p "كلمة مرور البائع (Password): " s_pass
    read -p "بورت الدخول الخاص بالبائع (مثال 5001): " s_port
    read -p "الجيجات المسموح له ببيعها (GB): " s_quota
    if ! [[ "$s_port" =~ ^[0-9]+$ ]] || ! [[ "$s_quota" =~ ^[0-9]+$ ]]; then echo "❌ البورت والجيجات أرقام فقط."; sleep 2; show_menu; return; fi
    echo "TOTAL_GB=$s_quota" > /etc/sultan/sellers/$s_user.conf
    echo "USED_GB=0" >> /etc/sultan/sellers/$s_user.conf
    echo "PORT=$s_port" >> /etc/sultan/sellers/$s_user.conf
    echo "PASS=$s_pass" >> /etc/sultan/sellers/$s_user.conf
    echo "EXP=Unlimited" >> /etc/sultan/sellers/$s_user.conf
    touch /etc/sultan/sellers/${s_user}_users.txt
    mkdir -p /opt/sultan-sellers/$s_user/templates
    cp /opt/sultan-sellers/seller_app_template.py /opt/sultan-sellers/$s_user/app.py
    cp /opt/sultan-sellers/seller_index_template.html /opt/sultan-sellers/$s_user/templates/index.html
    cat << SYS_EOF > /etc/systemd/system/sultan-seller-$s_user.service
[Unit]
Description=Sultan Seller Panel - $s_user
After=network.target
[Service]
User=root
WorkingDirectory=/opt/sultan-sellers/$s_user
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
SYS_EOF
    ufw allow $s_port/tcp >/dev/null 2>&1
    systemctl daemon-reload; systemctl enable sultan-seller-$s_user >/dev/null 2>&1; systemctl restart sultan-seller-$s_user
    echo "✅ تمت صناعة البائع بنجاح!"
    echo "🌐 الرابط: http://$IP:$s_port"
    read -p "اضغط Enter..."
    show_menu
}
edit_seller_quota() {
    clear
    get_sellers_array
    if [ ${#sellers[@]} -eq 0 ]; then echo "❌ لا يوجد بائعين."; sleep 2; show_menu; return; fi
    echo "--- تعديل الجيجات والأيام ---"
    for i in "${!sellers[@]}"; do echo "[$((i+1))] ${sellers[$i]}"; done
    echo "0. رجوع"
    echo "---------------------------"
    read -p "اختر رقم البائع: " choice
    if [[ "$choice" == "0" ]]; then show_menu; return; fi
    idx=$((choice-1))
    if [[ -z "${sellers[$idx]}" ]]; then echo "❌ اختيار خاطئ!"; sleep 2; edit_seller_quota; return; fi
    s_user="${sellers[$idx]}"
    CONF="/etc/sultan/sellers/$s_user.conf"
    echo "1. تعديل الجيجات (Add/Deduct GB)"
    echo "2. تعديل أيام الاشتراك (Add/Deduct Days)"
    read -p "اختر: " sub_opt
    if [ "$sub_opt" == "1" ]; then
        TOTAL=$(grep "TOTAL_GB" "$CONF" | cut -d'=' -f2)
        echo "الجيجات الحالية: $TOTAL GB"
        read -p "إضافة (50) أو خصم (-50): " add_gb
        NEW_TOTAL=$(echo "$TOTAL + $add_gb" | bc -l)
        sed -i "s/TOTAL_GB=.*/TOTAL_GB=$NEW_TOTAL/" "$CONF"
        echo "✅ الجيجات الجديدة: $NEW_TOTAL"
    elif [ "$sub_opt" == "2" ]; then
        EXP=$(grep "EXP=" "$CONF" | cut -d'=' -f2)
        echo "الانتهاء الحالي: ${EXP:-Unlimited}"
        read -p "إضافة (30) أو خصم (-30) أو 0 لجعله مفتوح: " add_days
        if [ "$add_days" == "0" ]; then NEW_EXP="Unlimited"
        else
            BASE=${EXP:-$(date +%Y-%m-%d)}
            [ "$BASE" == "Unlimited" ] && BASE=$(date +%Y-%m-%d)
            if [[ "$add_days" == -* ]]; then NEW_EXP=$(date -d "$BASE - ${add_days#-} days" +%Y-%m-%d)
            else NEW_EXP=$(date -d "$BASE + $add_days days" +%Y-%m-%d); fi
        fi
        sed -i "s/EXP=.*/EXP=$NEW_EXP/" "$CONF"
        echo "✅ الانتهاء الجديد: $NEW_EXP"
    fi
    read -p "اضغط Enter..."
    show_menu
}
manage_sellers() {
    clear
    get_sellers_array
    if [ ${#sellers[@]} -eq 0 ]; then echo "❌ لا يوجد بائعين."; sleep 2; show_menu; return; fi
    echo "--- قائمة البائعين ---"
    for i in "${!sellers[@]}"; do
        s_user="${sellers[$i]}"
        CONF="/etc/sultan/sellers/$s_user.conf"
        s_port=$(grep "PORT=" "$CONF" | cut -d'=' -f2)
        s_pass=$(grep "PASS=" "$CONF" | cut -d'=' -f2)
        echo "[$((i+1))] Seller: $s_user"
        echo "    Link: http://$IP:$s_port"
        echo "    Pass: $s_pass"
        echo "---------------------------"
    done
    echo "0. رجوع"
    echo "==========================="
    read -p "اختر رقم البائع لتعديل بيانات الدخول: " choice
    if [[ "$choice" == "0" ]]; then show_menu; return; fi
    idx=$((choice-1))
    if [[ -z "${sellers[$idx]}" ]]; then echo "❌ اختيار خاطئ!"; sleep 2; manage_sellers; return; fi
    s_user="${sellers[$idx]}"
    CONF="/etc/sultan/sellers/$s_user.conf"
    echo "تعديل بيانات الدخول للبائع [$s_user]:"
    echo "1. تغيير كلمة المرور (Password)"
    echo "2. تغيير اسم البائع (Username)"
    read -p "اختر: " m_opt
    if [ "$m_opt" == "1" ]; then
        read -p "كلمة المرور الجديدة: " n_pass
        sed -i "s/PASS=.*/PASS=$n_pass/" "$CONF"
        systemctl restart sultan-seller-$s_user
        echo "✅ تم تغيير كلمة المرور!"
    elif [ "$m_opt" == "2" ]; then
        read -p "اسم البائع الجديد: " n_user
        if [[ -z "$n_user" || "$n_user" =~ [^a-zA-Z0-9_-] ]]; then echo "❌ اسم غير صالح."; sleep 2; manage_sellers; return; fi
        if [ -f "/etc/sultan/sellers/$n_user.conf" ]; then echo "❌ الاسم موجود مسبقاً!"; sleep 2; manage_sellers; return; fi
        systemctl stop sultan-seller-$s_user >/dev/null 2>&1
        mv /etc/sultan/sellers/$s_user.conf /etc/sultan/sellers/$n_user.conf
        mv /etc/sultan/sellers/${s_user}_users.txt /etc/sultan/sellers/${n_user}_users.txt
        mv /opt/sultan-sellers/$s_user /opt/sultan-sellers/$n_user
        mv /etc/systemd/system/sultan-seller-$s_user.service /etc/systemd/system/sultan-seller-$n_user.service
        sed -i "s/$s_user/$n_user/g" /etc/systemd/system/sultan-seller-$n_user.service
        systemctl daemon-reload
        systemctl enable sultan-seller-$n_user >/dev/null 2>&1
        systemctl start sultan-seller-$n_user
        echo "✅ تم تغيير اسم البائع وتحديث لوحته بنجاح!"
    fi
    read -p "اضغط Enter..."
    show_menu
}

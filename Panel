cat << 'APP_EOF' > /opt/sultan-sellers/seller_app_template.py
import os, subprocess, json
from flask import Flask, render_template, request, jsonify, Response, redirect

SELLER_NAME = os.path.basename(os.path.dirname(os.path.abspath(__file__)))
SELLER_CONF = f"/etc/sultan/sellers/{SELLER_NAME}.conf"
SELLER_USERS_FILE = f"/etc/sultan/sellers/{SELLER_NAME}_users.txt"
DB_FILE = "/etc/sultan/users.db"
USAGE_FILE = "/etc/sultan/limits/usage.db"

SELLER_PORT = 5000
SELLER_PASS = "admin"
SELLER_EXP = "Unlimited"

def load_seller_conf():
    global SELLER_PORT, SELLER_PASS, SELLER_EXP
    if os.path.exists(SELLER_CONF):
        with open(SELLER_CONF, "r") as f:
            for line in f:
                if line.startswith("PORT="): SELLER_PORT = int(line.strip().split("=")[1])
                if line.startswith("PASS="): SELLER_PASS = line.strip().split("=")[1]
                if line.startswith("EXP="): SELLER_EXP = line.strip().split("=")[1]

load_seller_conf()
app = Flask(__name__, template_folder="templates")

def check_auth(username, password):
    load_seller_conf()
    return username == SELLER_NAME and password == SELLER_PASS
def authenticate(): return Response('ممنوع الدخول! يرجى إدخال البيانات.', 401, {'WWW-Authenticate': 'Basic realm="Seller Panel"'})

@app.before_request
def require_auth():
    load_seller_conf()
    auth = request.authorization
    if not auth or not check_auth(auth.username, auth.password): return authenticate()
    if SELLER_EXP not in ["Unlimited", "", "0"]:
        try:
            exp_ts = int(subprocess.getoutput(f"date -d '{SELLER_EXP} 23:59:59' +%s"))
            now_ts = int(subprocess.getoutput("date +%s"))
            if now_ts > exp_ts: return Response('اشتراك البائع منتهي! يرجى التواصل مع الإدارة.', 403)
        except: pass

def get_user_consumed_gb(username):
    if not os.path.exists(USAGE_FILE): return 0.0
    with open(USAGE_FILE, "r") as f:
        for line in f:
            parts = line.strip().split('|')
            if len(parts) >= 2 and parts[0] == username:
                try: return float(parts[1]) / (1024**3)
                except: return 0.0
    return 0.0

def format_bytes(b):
    try: b = float(b)
    except: return "0.00 B"
    if b < 1024: return f"{b:.2f} B"
    elif b < 1048576: return f"{b/1024:.2f} KB"
    elif b < 1073741824: return f"{b/1048576:.2f} MB"
    else: return f"{b/1073741824:.2f} GB"

def calc_percent(used, quota_str):
    if quota_str in ["Unlimited", "0", ""]: return 0
    try:
        gb = float(quota_str.upper().replace("GB", "").strip())
        total_bytes = gb * 1024 * 1024 * 1024
        if total_bytes == 0: return 0
        return min((used / total_bytes) * 100, 100)
    except: return 0

def get_seller_data():
    total, used = 0.0, 0.0
    if os.path.exists(SELLER_CONF):
        with open(SELLER_CONF, "r") as f:
            for line in f:
                if "=" in line:
                    k, v = line.strip().split("=")
                    if k == "TOTAL_GB": total = float(v)
                    if k == "USED_GB": used = float(v)
    return total, used

def save_seller_data(total, used):
    lines = []
    if os.path.exists(SELLER_CONF):
        with open(SELLER_CONF, "r") as f: lines = f.readlines()
    with open(SELLER_CONF, "w") as f:
        for line in lines:
            if line.startswith("TOTAL_GB="): f.write(f"TOTAL_GB={total:.3f}\n")
            elif line.startswith("USED_GB="): f.write(f"USED_GB={used:.3f}\n")
            else: f.write(line)

def get_seller_users_list():
    if not os.path.exists(SELLER_USERS_FILE): return []
    with open(SELLER_USERS_FILE, "r") as f: return [l.strip() for l in f if l.strip()]

def get_users_data():
    users = []
    seller_users = get_seller_users_list()
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            for line in f:
                if line.strip():
                    parts = line.strip().split('|')
                    if len(parts) >= 5 and parts[0] in seller_users:
                        used_bytes = get_user_consumed_gb(parts[0]) * (1024**3)
                        online = len(os.listdir(f"/run/sultan-login-slots/{parts[0]}")) if os.path.isdir(f"/run/sultan-login-slots/{parts[0]}") else 0
                        users.append({
                            "user": parts[0], "pass": parts[1], "exp": parts[2], "quota": parts[3], "logins": parts[4],
                            "used_formatted": format_bytes(used_bytes), "percent": calc_percent(used_bytes, parts[3]), "online": online
                        })
    return users

def reset_user_usage(username):
    uid = subprocess.getoutput(f"id -u {username}").strip()
    if not uid.isdigit(): return
    cur_in = subprocess.getoutput(f"systemctl show 'user-{uid}.slice' -p IPIngressBytes --value 2>/dev/null").strip()
    cur_out = subprocess.getoutput(f"systemctl show 'user-{uid}.slice' -p IPEgressBytes --value 2>/dev/null").strip()
    cur_nft = subprocess.getoutput(f"nft -j list counter inet sultan_quota u_{uid}_out 2>/dev/null | jq -r '.. | objects | select(has(\"bytes\")) | .bytes' 2>/dev/null | head -n1").strip()
    if not cur_in.isdigit(): cur_in = "0"
    if not cur_out.isdigit(): cur_out = "0"
    if not cur_nft.isdigit(): cur_nft = "0"
    lines = []
    if os.path.exists(USAGE_FILE):
        with open(USAGE_FILE, "r") as f: lines = [l for l in f if not l.startswith(f"{username}|")]
    lines.append(f"{username}|0|{cur_in}|{cur_out}|{cur_nft}\n")
    with open(USAGE_FILE, "w") as f: f.writelines(lines)

def delete_user_records(username):
    for db in [USAGE_FILE, "/etc/sultan/limits/blocked.db", "/etc/sultan/limits/quota-locked.db"]:
        if os.path.exists(db):
            with open(db, "r") as f: clean_lines = [l for l in f if not l.startswith(f"{username}|") and l.strip() != username]
            with open(db, "w") as f: f.writelines(clean_lines)

@app.route('/')
def index():
    total_gb, used_gb = get_seller_data()
    return render_template('index.html', users=get_users_data(), rem_gb=round(total_gb - used_gb, 3), total_users=len(get_users_data()), seller_name=SELLER_NAME, domain=subprocess.getoutput("cat /etc/sultan/domain 2>/dev/null") or "s.sultanmuhamad.xyz")

@app.route('/api/data')
def api_data(): return jsonify({"users": get_users_data()})

@app.route('/add', methods=['POST'])
def add_user():
    user, password, days, quota, logins = request.json.get('user'), request.json.get('password'), request.json.get('days','30'), request.json.get('quota','1'), request.json.get('logins','1')
    try: req_quota = float(quota)
    except: return jsonify({"status": "error", "msg": "كمية الجيجات غير صالحة"}), 400
    if req_quota <= 0: return jsonify({"status": "error", "msg": "غير مسموح بإنشاء حسابات مفتوحة للموزعين!"}), 400
    total_gb, used_gb = get_seller_data()
    if req_quota > (total_gb - used_gb): return jsonify({"status": "error", "msg": f"رصيد غير كافٍ. المتبقي: {total_gb - used_gb:.3f} GB"}), 400
    if os.path.exists(DB_FILE) and user in subprocess.getoutput(f"cat {DB_FILE}"): return jsonify({"status": "error", "msg": "هذا الاسم مستخدم!"}), 400
    os.system(f"useradd -m -s /bin/bash {user}; echo '{user}:{password}' | chpasswd")
    exp_date = subprocess.getoutput(f"date -d '+{days} days' +%Y-%m-%d") if str(days) != "0" else "Unlimited"
    if exp_date != "Unlimited": os.system(f"chage -E {exp_date} {user}")
    with open(DB_FILE, "a") as f: f.write(f"{user}|{password}|{exp_date}|{req_quota}GB|{logins}\n")
    with open(SELLER_USERS_FILE, "a") as f: f.write(f"{user}\n")
    save_seller_data(total_gb, used_gb + req_quota)
    reset_user_usage(user)
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

@app.route('/delete', methods=['POST'])
def delete_user():
    user = request.json.get('user')
    if user not in get_seller_users_list(): return jsonify({"status": "error", "msg": "لا تملك صلاحية لحذف هذا المستخدم"}), 403
    os.system(f"pkill -KILL -u {user}; userdel -r {user}")
    
    allocated_gb = 0.0
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            for l in f:
                if l.startswith(user+"|"):
                    q_str = l.split('|')[3].upper().replace("GB","").strip()
                    if q_str not in ["UNLIMITED", "0", ""]: allocated_gb = float(q_str)
    
    consumed_gb = get_user_consumed_gb(user)
    if allocated_gb > 0:
        unused_gb = max(0.0, allocated_gb - consumed_gb)
        total_gb, used_gb = get_seller_data()
        save_seller_data(total_gb, used_gb - unused_gb)

    users_list = [l.strip() for l in open(DB_FILE) if l.strip() and not l.startswith(f"{user}|")]
    with open(DB_FILE, "w") as f: f.write("\n".join(users_list) + "\n")
    
    s_users = get_seller_users_list()
    s_users.remove(user)
    with open(SELLER_USERS_FILE, "w") as f: f.write("\n".join(s_users) + "\n")
    
    delete_user_records(user)
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

@app.route('/edit', methods=['POST'])
def edit_user():
    user = request.json.get('user')
    new_pass, new_days, new_quota, new_logins = request.json.get('password'), request.json.get('days'), request.json.get('quota'), request.json.get('logins')
    if user not in get_seller_users_list(): return jsonify({"status": "error", "msg": "لا تملك صلاحية"}), 403
    users_list = []
    with open(DB_FILE, "r") as f:
        for line in f:
            parts = line.strip().split('|')
            if len(parts) >= 5 and parts[0] == user:
                if new_pass: parts[1] = new_pass; os.system(f"echo '{user}:{new_pass}' | chpasswd")
                
                if new_days and new_days.strip() != "":
                    try:
                        nd = int(new_days)
                        if nd == 0: parts[2] = "Unlimited"; os.system(f"chage -E -1 {user}")
                        else:
                            base = parts[2] if parts[2] not in ["Unlimited", "0", ""] else subprocess.getoutput("date +%Y-%m-%d")
                            sign = "-" if nd < 0 else "+"
                            exp_date = subprocess.getoutput(f"date -d '{base} {sign} {abs(nd)} days' +%Y-%m-%d")
                            parts[2] = exp_date; os.system(f"chage -E {exp_date} {user}")
                    except: pass
                
                if new_quota and new_quota.strip() != "":
                    try:
                        add_q = float(new_quota)
                        total_gb, used_gb = get_seller_data()
                        
                        if add_q > 0 and add_q > (total_gb - used_gb):
                            return jsonify({"status": "error", "msg": f"رصيد غير كافٍ. المتبقي: {total_gb - used_gb:.3f} GB"}), 400
                            
                        oq_str = parts[3].upper().replace("GB","").strip()
                        oq = float(oq_str) if oq_str not in ["UNLIMITED", "0", ""] else 0.0
                        new_q = oq + add_q
                        if new_q <= 0: return jsonify({"status": "error", "msg": "لا يمكن خصم جيجات أكثر من رصيد المستخدم!"}), 400
                        
                        parts[3] = f"{new_q:.3f}GB"
                        save_seller_data(total_gb, used_gb + add_q)
                    except: pass
                
                if new_logins and new_logins.strip() != "":
                    try:
                        nl = int(new_logins)
                        parts[4] = "Unlimited" if nl == 0 else str(nl)
                    except: pass
            if line.strip(): users_list.append(parts)
    with open(DB_FILE, "w") as f:
        for u in users_list: f.write("|".join(u) + "\n")
    os.system("/usr/local/sbin/sultan-quota-sync >/dev/null 2>&1 &")
    return jsonify({"status": "success"})

if __name__ == '__main__': app.run(host='0.0.0.0', port=SELLER_PORT)

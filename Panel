# ========================================================
# 5. رسالة الـ SSH Banner الترحيبية
# ========================================================
cat << 'BANNER_EOF' > /etc/profile.d/sultan-banner.sh
#!/bin/bash
if [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_CLIENT" ]; then
    USER_NAME="$USER"
    DB_FILE="/etc/sultan/users.db"
    USAGE_FILE="/etc/sultan/limits/usage.db"
    if grep -q "^${USER_NAME}|" "$DB_FILE" 2>/dev/null; then
        LINE=$(grep "^${USER_NAME}|" "$DB_FILE" | head -n1)
        EXP=$(echo "$LINE" | cut -d'|' -f3)
        QUOTA=$(echo "$LINE" | cut -d'|' -f4)
        MAX_LOGINS=$(echo "$LINE" | cut -d'|' -f5)
        USED_BYTES=0
        if grep -q "^${USER_NAME}|" "$USAGE_FILE" 2>/dev/null; then USED_BYTES=$(grep "^${USER_NAME}|" "$USAGE_FILE" | cut -d'|' -f2); fi
        USED_GB=$(awk -v b="$USED_BYTES" 'BEGIN { printf "%.2f", b / 1073741824 }')
        if [[ "$QUOTA" == "Unlimited" || "$QUOTA" == "0" || -z "$QUOTA" ]]; then
            QUOTA_GB="Unlimited"; REM_GB="Unlimited"
        else
            Q_VAL=$(echo "$QUOTA" | sed 's/GB//gi' | tr -d ' ')
            QUOTA_GB=$(awk -v q="$Q_VAL" 'BEGIN { printf "%.2f", q }')
            REM_GB=$(awk -v q="$QUOTA_GB" -v u="$USED_GB" 'BEGIN { r = q - u; if(r<0) r=0; printf "%.2f", r }')
        fi
        if [[ "$EXP" == "Unlimited" || "$EXP" == "0" || -z "$EXP" ]]; then EXP_STR="Unlimited"
        else
            NOW=$(date +%s); EXP_TS=$(date -d "$EXP 23:59:59" +%s 2>/dev/null || echo 0)
            if [ "$EXP_TS" -gt "$NOW" ]; then DIFF=$((EXP_TS - NOW)); DAYS=$((DIFF / 86400)); HOURS=$(((DIFF % 86400) / 3600)); EXP_STR="(${DAYS}d ${HOURS}h) $EXP"
            else EXP_STR="(منتهي) $EXP"; fi
        fi
        ACTIVE=0; DIR="/run/sultan-login-slots/$USER_NAME"
        if [ -d "$DIR" ]; then ACTIVE=$(find "$DIR" -type f 2>/dev/null | wc -l); fi
        [ "$MAX_LOGINS" == "Unlimited" ] || [ "$MAX_LOGINS" == "0" ] && MAX_LOGINS="Unlimited"
        echo -e "\n\e[1;33m✨ حالة الحساب ✨\e[0m\n"
        echo -e "\e[1;34m👤 المستخدم :\e[0m \e[1;37m$USER_NAME\e[0m"
        echo -e "\e[1;34m📅 الانتهاء  :\e[0m \e[1;37m$EXP_STR\e[0m"
        echo -e "\e[1;34m📊 البيانات  :\e[0m \e[1;37mGB $QUOTA_GB / $USED_GB\e[0m"
        echo -e "\e[1;34m💾 المتبقي   :\e[0m \e[1;37mGB $REM_GB\e[0m"
        echo -e "\e[1;34m🔗 الجلسات   :\e[0m \e[1;37m$MAX_LOGINS / $ACTIVE\e[0m"
        echo -e "\n----------------------------------------\n"
    fi
fi
BANNER_EOF
chmod +x /etc/profile.d/sultan-banner.sh

echo "🎉 تم الانتهاء بنجاح! السيرفر الآن يعمل بكامل طاقته ومميزاته."
EOF

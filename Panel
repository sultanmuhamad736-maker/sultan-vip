            <div class="input-group"><label>Max Logins</label><input type="number" id="add_logins" value="1"></div>
            <button class="btn-save" style="width:100%" onclick="saveNewUser()">Save</button>
        </div>
    </div>

    <div id="editModal" class="modal">
        <div class="modal-content">
            <div class="modal-header"><h3 style="color:white;margin:0;">Edit User</h3><span class="close-btn" onclick="closeModals()">&times;</span></div>
            <div class="input-group"><label>Username</label><input type="text" id="edit_user" disabled></div>
            <div class="input-group"><label>New Password</label><input type="text" id="edit_pass" placeholder="Leave empty to keep"></div>
            <div style="display:flex; gap:10px;">
                <div class="input-group" style="flex:1;"><label>Add/Deduct Days</label><input type="number" id="edit_days" placeholder="e.g. 5 or -5"></div>
                <div class="input-group" style="flex:1;"><label>Add/Deduct GB</label><input type="number" step="any" id="edit_quota" placeholder="e.g. 1.001 or -0.5"></div>
            </div>
            <div class="input-group"><label>Max Logins</label><input type="number" id="edit_logins" placeholder="Leave empty to keep"></div>
            <button class="btn-save" style="width:100%" onclick="saveEditUser()">Save Changes</button>
        </div>
    </div>

    <script>
        const DOMAIN = "{{ domain }}";
        let activeUserInfo = {};
        
        setInterval(async () => {
            try {
                let res = await fetch('/api/data'); let data = await res.json();
                data.users.forEach(u => {
                    let txt = document.getElementById('text_usage_' + u.user); let bar = document.getElementById('bar_usage_' + u.user); let onl = document.getElementById('online_status_' + u.user);
                    if(txt) txt.innerText = u.used_formatted + ' / ' + u.quota;
                    if(bar) bar.style.width = u.percent + '%';
                    if(onl) {
                        if(u.online > 0) { onl.innerHTML = '🟢 Online: ' + u.online + ' / ' + u.logins; onl.style.color = '#34d399'; }
                        else { onl.innerHTML = '⚪ Online: ' + u.online + ' / ' + u.logins; onl.style.color = '#94a3b8'; }
                    }
                    if (document.getElementById('infoModal').style.display === 'flex' && activeUserInfo.user === u.user) {
                        document.getElementById('infoContent').innerText = "Username : " + u.user + "\nPassword : " + activeUserInfo.pass + "\nExpire   : " + u.exp + "\nQuota    : " + u.quota + "\nUsed     : " + u.used_formatted + "\nMax Login: " + u.logins + "\nOnline   : " + u.online;
                    }
                });
            } catch(e) {}
        }, 3000);

        function showInfoModal(user, pass, exp, quota, logins) { activeUserInfo = {user: user, pass: pass}; document.getElementById('infoContent').innerText = "Username : " + user + "\nPassword : " + pass + "\nExpire   : " + exp + "\nQuota    : " + quota + "\nUsed     : ...\nMax Login: " + logins + "\nOnline   : ..."; document.getElementById('infoModal').style.display = 'flex'; }
        function copyInfoBox() { const el = document.createElement('textarea'); el.value = document.getElementById('infoContent').innerText; document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el); alert("تم النسخ بنجاح!"); }
        
        function copyConfig(user, pass) {
            const text = "User : " + user + "\n\nPassword : " + pass + "\n\nSNI : " + DOMAIN + "\n\nPayload :\n\nGET /cdn-cgi/trace HTTP/1.1[crlf]Host:  172.65.90.47[crlf][crlf]CF-RAY / HTTP/1.1[crlf]Host:  " + DOMAIN + "[crlf]Upgrade:  Websocket[crlf]Connection:  Keep-Alive[crlf]User-Agent:  [ua][crlf]Upgrade:  websocket[crlf][crlf]\n\nSNI social :\n www.twitter.com\n or \nwww.snapchat.com\n\nPayload social :\n\nGET / HTTP/1.1[crlf]Host: www.snapchat.com[crlf]Upgrade: websocket[crlf][crlf]\n\nOr\n\nGET / HTTP/1.1[crlf]Host: www.twitter.com[crlf]Upgrade: websocket[crlf][crlf]";
            const el = document.createElement('textarea'); el.value = text; document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el); alert("تم النسخ بنجاح!");
        }

        function showAddModal() { document.getElementById('addModal').style.display = 'flex'; }
        function showEditModal(user) { document.getElementById('edit_user').value = user; document.getElementById('edit_pass').value = ''; document.getElementById('edit_days').value = ''; document.getElementById('edit_quota').value = ''; document.getElementById('edit_logins').value = ''; document.getElementById('editModal').style.display = 'flex'; }
        function closeModals() { document.querySelectorAll('.modal').forEach(m => m.style.display = 'none'); activeUserInfo = {}; }

        async function saveNewUser() {
            const user = document.getElementById('add_user').value; const pass = document.getElementById('add_pass').value; const days = document.getElementById('add_days').value; const quota = document.getElementById('add_quota').value; const logins = document.getElementById('add_logins').value;
            if(!user || !pass) return alert("الرجاء إدخال اسم المستخدم وكلمة المرور");
            try {
                let res = await fetch('/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user: user, password: pass, days: days, quota: quota, logins: logins }) });
                let r = await res.json();
                if(r.status == "error") alert(r.msg);
                else window.location.reload();
            } catch(e) { alert("خطأ في الاتصال بالسيرفر! تأكد من صحة البيانات."); }
        }
        
        async function deleteUser(user) {
            if(!confirm("هل أنت متأكد من حذف " + user + "؟")) return;
            let res = await fetch('/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user: user }) });
            let r = await res.json();
            if(r.status == "error") alert(r.msg);
            else window.location.reload();
        }
        
        async function saveEditUser() {
            const user = document.getElementById('edit_user').value; const pass = document.getElementById('edit_pass').value; const days = document.getElementById('edit_days').value; const quota = document.getElementById('edit_quota').value; const logins = document.getElementById('edit_logins').value;
            await fetch('/edit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ user: user, password: pass, days: days, quota: quota, logins: logins }) });
            window.location.reload();
        }
    </script>
</body>
</html>
